# ── Copier ce fichier en `.env` et renseigner les valeurs ────
# `.env` est ignoré par git (.gitignore) : ne jamais committer de secrets.

PORT=3506
NODE_ENV=development

# ── Base de données (MariaDB / MySQL) ────────────────────────
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DB_NAME"
DB_PORT=3306
DB_NAME="ma_base"
DB_HOST="localhost"
DB_USER="mon_user"
DB_PASSWORD="mon_mot_de_passe_fort"
# true dès que la base n'est pas en localhost (TLS obligatoire)
DB_SSL=false

# ── Sessions ─────────────────────────────────────────────────
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="REMPLACER_PAR_UNE_CHAINE_ALEATOIRE_DE_96_CARACTERES"

# ── Email (SMTP) — mot de passe d'application, pas le mot de passe du compte
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=adresse@exemple.com
SMTP_PASS=xxxx xxxx xxxx xxxx

# ── API énergie (ENTSO-E Transparency Platform) ──────────────
# Jeton gratuit : https://transparency.entsoe.eu → Mon compte → Web API Security Token
ENTSOE_API_KEY=votre_token_entsoe
# Délai max (ms) avant abandon de l'appel ENTSO-E. Optionnel.
# Défaut : 3000 en dev/test, 10000 en production.
# ENTSOE_TIMEOUT_MS=3000
# Nombre de tentatives par rafraîchissement (l'API ENTSO-E est intermittente).
# Optionnel. Défaut : 2 (1 = aucune nouvelle tentative).
# ENTSOE_RETRIES=2

# URL publique de l'app (liens emails). En prod : https://...
# APP_URL=https://mon-domaine.fr
# SERVER_URL=https://mon-domaine.fr
