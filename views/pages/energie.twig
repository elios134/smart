{# ── Page Énergie (vue Twig) ──────────────────────────────────
   Twig est un "moteur de templates" : il mélange du HTML avec des balises
   spéciales remplies côté serveur par le contrôleur energieController.js.
     {{ ... }} = afficher une valeur     {% ... %} = logique (if, for…)
     {# ... #} = commentaire (invisible dans la page finale)
   La page est organisée en 4 onglets (Mix / Sources / Seuils / Prix), gérés
   par public/script/energie.js via les attributs data-tab.
   ────────────────────────────────────────────────────────── #}
{% extends "layouts/base.twig" %} {# Réutilise la mise en page commune (squelette HTML). #}

{% block style %}
	<link rel="stylesheet" href="/css/energie.css"> {# Styles propres à la page énergie. #}
{% endblock %}

{% block header %}
	{% include "partials/_navbar.twig" %} {# Barre de navigation commune. #}
{% endblock %}

{% block main %}
	<div class="main">

		{# Messages "flash" : bandeau vert (succès) ou rouge (erreur) après une action.
		   Leur contenu vient des paramètres ?success=... / ?error=... de l'URL. #}
		{% if flash.success %}
			<div class="toast toast-success">✓
				{{ flash.success }}</div>
		{% endif %}
		{% if flash.error %}
			<div class="toast toast-error">✕
				{{ flash.error }}</div>
		{% endif %}

		{# En-tête de page : titre + pastille "temps réel" affichée si le mix est disponible. #}
		<div class="page-header">
			<h1 class="page-header__title">Pilotage énergétique</h1>
			{% if mixObj %}
				<div class="page-header__sub"><span class="page-header__live-dot"></span> Temps réel — ENTSO-E</div>
			{% endif %}
		</div>

		{# Barre des onglets. data-tab relie chaque onglet à son panneau (id="tab-...").
		   Le changement d'onglet est géré par energie.js. #}
		<div class="page-tabs-bar">
			<a class="page-tab active" data-tab="mix" href="#">Mix ENTSO-E</a>
			<a class="page-tab" data-tab="sources" href="#">Sources</a>
			<a class="page-tab" data-tab="config" href="#">Seuils</a>
			<a class="page-tab" data-tab="prix" href="#">Prix énergie</a>
		</div>

		{# Cartes d'alerte : affichées seulement si le contrôleur a détecté des sources
		   dont la part dans le mix est passée sous le seuil d'arrêt (→ il faut vendre). #}
		{% if alertes %}
			<div class="energie-alertes">
				{% for a in alertes %}
					<div class="alerte-card alerte-card--vente">
						<div>
							<div class="alerte-card__badge">Alerte vente</div>
							<div class="alerte-card__name">{{ a.source.nom }}</div>
							<div class="alerte-card__sub">Mix
								{{ a.source.type }}
								:
								{{ a.mixPct }}% — sous le seuil d'arrêt</div>
						</div>
						<a href="/ventes?source={{ a.source.id }}" class="btn btn-danger">Vendre</a>
					</div>
				{% endfor %}
			</div>
		{% endif %}

		{# ── TAB MIX : mix énergétique national en temps réel (données ENTSO-E) ── #}
		<div id="tab-mix" class="tab-panel active">
			<div class="card">
				<div class="card__header">
					<span class="card__title">Mix Production National — France</span>
					{# Badge "LIVE" si l'API a répondu (mixObj non nul), sinon badge "non configurée". #}
					{% if mixObj %}
						<span class="badge badge-green">LIVE ENTSO-E</span>
					{% else %}
						<span class="badge badge-muted">API non configurée</span>
					{% endif %}
				</div>
				{# Si on a des données : on affiche le total réseau, l'heure, puis un KPI par énergie. #}
				{% if mixObj %}
					<div class="cours-header">
						<div>
							<div class="cours-header__title">Données en temps réel</div>
							<div class="cours-header__meta">Total réseau :
								{{ mixObj._totalMW }}
								MW —
								{{ mixObj._fetchedAt }}</div>
						</div>
					</div>
					{# Un encart par type d'énergie, affiché uniquement si présent dans le mix. #}
					<div class="mix-donut-wrap">
							<canvas id="chart-mix" role="img" aria-label="Repartition du mix energetique national"
								data-eolien="{{ mixObj.EOLIEN ?? '' }}"
								data-solaire="{{ mixObj.SOLAIRE ?? '' }}"
								data-hydraulique="{{ mixObj.HYDRAULIQUE ?? '' }}"
								data-nucleaire="{{ mixObj.NUCLEAIRE ?? '' }}"></canvas>
						</div>
						<div class="cours-kpis">
						{% if mixObj.EOLIEN is defined %}
							<div class="cours-kpi">
								<div class="cours-kpi__label">Éolien</div>
								<div class="cours-kpi__value">{{ mixObj.EOLIEN }}%</div>
							</div>
						{% endif %}
						{% if mixObj.SOLAIRE is defined %}
							<div class="cours-kpi">
								<div class="cours-kpi__label">Solaire</div>
								<div class="cours-kpi__value">{{ mixObj.SOLAIRE }}%</div>
							</div>
						{% endif %}
						{% if mixObj.HYDRAULIQUE is defined %}
							<div class="cours-kpi">
								<div class="cours-kpi__label">Hydraulique</div>
								<div class="cours-kpi__value">{{ mixObj.HYDRAULIQUE }}%</div>
							</div>
						{% endif %}
						{% if mixObj.NUCLEAIRE is defined %}
							<div class="cours-kpi">
								<div class="cours-kpi__label">Nucléaire</div>
								<div class="cours-kpi__value">{{ mixObj.NUCLEAIRE }}%</div>
							</div>
						{% endif %}
					</div>
				{% else %}
					<p class="empty-state">Configurez ENTSOE_API_KEY dans votre .env pour activer les données temps réel</p>
				{% endif %}
			</div>
		</div>

		{# ── TAB SOURCES : tableau des sources d'énergie + actions (ajout/modif/suppr) ── #}
		<div id="tab-sources" class="tab-panel">
			<div class="card">
				<div class="card__header">
					<span class="card__title">Sources d'énergie</span>
					{# data-modal-open ouvre la fenêtre (modale) correspondante, définie plus bas. #}
					<div style="display:flex; gap:10px;">
						<form method="POST" action="/energie/sources/import" style="margin:0;">
							<button type="submit" class="btn btn-outline">Importer depuis le mix</button>
						</form>
						<button class="btn btn-primary" data-modal-open="modal-source-add">Ajouter</button>
					</div>
				</div>
				<table class="table--sm-hide-2-3-4">
					<thead>
						<tr>
							<th>Source</th>
							<th>Type</th>
							<th>Coût prod.</th>
							<th>Mix actuel</th>
							<th>Stock</th>
							<th>Auto</th>
							<th>Statut</th>
							<th>Actions</th>
						</tr>
					</thead>
					<tbody>
						{# Une ligne par source. {% else %} (plus bas) gère le cas "liste vide". #}
						{% for s in sources %}
							<tr>
								<td>{{ s.nom }}</td>
								<td>
									<span class="badge badge-blue">{{ s.type }}</span>
								</td>
								<td>{{ s.coutProduction }}
									€/MWh</td>
								<td>
									{# Part actuelle de cette énergie dans le mix, avec couleur selon le niveau :
									   vert ≥ 20 %, bleu ≥ 10 %, rouge sinon. "—" si donnée indisponible. #}
									{% if mixObj and attribute(mixObj, s.type) is defined %}
										<span class="badge {% if attribute(mixObj, s.type) >= 20 %}badge-green{% elseif attribute(mixObj, s.type) >= 10 %}badge-blue{% else %}badge-red{% endif %}">{{ attribute(mixObj, s.type) }}%</span>
									{% else %}
										<span class="badge badge-muted">—</span>
									{% endif %}
								</td>
								<td>{{ s.stock.quantite ?? 0 }}
									MWh</td>
								<td>
										{% if s.seuil and s.seuil.declenchementAuto %}
											<label class="toggle"><input type="checkbox" checked disabled><span class="toggle__track"></span><span class="toggle__thumb"></span></label>
										{% else %}
											<span class="badge badge-muted">—</span>
										{% endif %}
									</td>
									<td>
									{% if s.actif %}
										<span class="badge badge-green">ACTIF</span>
									{% else %}
										<span class="badge badge-muted">INACTIF</span>
									{% endif %}
								</td>
								<td>
									{# Bouton "Modifier" : data-action = URL du formulaire, data-fields = valeurs
									   pré-remplies dans la modale (JSON lu par le script générique des modales),
									   data-actif = état de la case Actif (lu par energie.js). #}
									<button class="btn btn-outline" data-modal-open="modal-source-edit" data-form="form-source-edit" data-action="/energie/sources/{{ s.id }}/edit" data-fields='{"edit-s-nom":"{{ s.nom }}","edit-s-cout":"{{ s.coutProduction }}","edit-s-cap":"{{ s.capaciteMax }}","edit-s-couleur":"{{ s.couleur }}","edit-s-type":"{{ s.type }}"}' data-actif="{{ s.actif ? '1' : '0' }}">
										Modifier
									</button>
									{# Suppression réservée au SUPER_ADMIN (double sécurité avec le routeur). #}
									{% if userRole == 'SUPER_ADMIN' %}
										<button class="btn btn-danger" data-modal-open="modal-source-delete" data-form="form-source-delete" data-action="/energie/sources/{{ s.id }}/delete" data-confirm-text="Supprimer {{ s.nom }} ?" data-confirm-target="delete-source-text">
											Supprimer
										</button>
									{% endif %}
								</td>
							</tr>
						{% else %}
							<tr>
								<td colspan="8" class="empty-state">Aucune source configurée</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>
		</div>

		{# ── TAB SEUILS : configuration de l'automatisation (déclenchement/arrêt) ── #}
		<div id="tab-config" class="tab-panel">
			<div class="card">
				<div class="card__header">
					<span class="card__title">Configuration des seuils</span>
					<button class="btn btn-primary" data-modal-open="modal-seuil-add">Configurer</button>
				</div>
				<table class="table--sm-hide-3-4">
					<thead>
						<tr>
							<th>Source</th>
							<th>Seuil déclenchement</th>
							<th>Seuil arrêt</th>
							<th>Auto</th>
							<th>Statut</th>
							<th>Actions</th>
						</tr>
					</thead>
					<tbody>
						{% for s in seuils %}
							<tr>
								<td>{{ s.source.nom }}</td>
								<td>
									<span class="taux-pill taux-pill--achat">{{ s.seuilDeclenchement }}%</span>
								</td>
								<td>
									<span class="taux-pill taux-pill--vente">{{ s.seuilArret }}%</span>
								</td>
								<td>
									{# Interrupteur "Auto" en lecture seule (disabled) : il REFLÈTE l'état
									   enregistré, il ne sert pas à le modifier ici (ça se fait dans la modale). #}
									<label class="toggle">
										<input type="checkbox" {% if s.declenchementAuto %} checked {% endif %} disabled>
										<span class="toggle__track"></span>
										<span class="toggle__thumb"></span>
									</label>
								</td>
								<td>
									{% if s.statut == 'ACTIF' %}
										<span class="badge badge-green">ACTIF</span>
									{% else %}
										<span class="badge badge-muted">INACTIF</span>
									{% endif %}
								</td>
								<td>
									<button class="btn btn-danger" data-modal-open="modal-seuil-delete" data-form="form-seuil-delete" data-action="/energie/seuils/{{ s.id }}/delete" data-confirm-text="Supprimer le seuil de {{ s.source.nom }} ?" data-confirm-target="delete-seuil-text">
										Supprimer
									</button>
								</td>
							</tr>
						{% else %}
							<tr>
								<td colspan="6" class="empty-state">Aucun seuil configuré</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>
		</div>


		{# ── TAB PRIX : graphique d'évolution des prix sur 12 mois ──
		   Le <canvas> est rempli par Chart.js dans energie.js, qui récupère les
		   données via fetch('/energie/prix-historique'). Le <p> "empty" s'affiche
		   s'il n'y a aucune donnée. #}
		<div id="tab-prix" class="tab-panel">
			<div class="card">
				<div class="card__header">
					<span class="card__title">Évolution des prix énergie — 12 derniers mois</span>
					<div class="chart-legend" style="margin-top:0;">
						<div class="chart-legend__item">
							<div class="chart-legend__dot chart-legend__dot--line-success" style="background:#2FEEA8;"></div>
							<span>Prix vente moyen (€/MWh)</span>
						</div>
						<div class="chart-legend__item">
							<div class="chart-legend__dot" style="background:linear-gradient(180deg, rgba(79,138,255,0.9), rgba(79,138,255,0.12));"></div>
							<span>Prix achat moyen (€/MWh)</span>
						</div>
					</div>
				</div>
				<div class="chart-wrap" style="height:260px;margin-top:8px;">
					<canvas id="chart-prix-energie"></canvas>
				</div>
				<p id="prix-energie-empty" class="empty-state" style="display:none;">Aucune donnée de vente ou d'achat enregistrée pour le moment.</p>
			</div>
		</div>

	</div>

	{# ── MODALES ──────────────────────────────────────────────
	   Fenêtres cachées par défaut, affichées via les boutons data-modal-open.
	   Chaque modale contient un formulaire qui POST vers une route du routeur. #}

	<!-- Modal Ajout source -->
	<div id="modal-source-add" class="modal-backdrop">
		<div class="modal">
			<h3 class="modal__title">Ajouter une source d'énergie</h3>
			<form method="POST" action="/energie/sources/add">
				<div class="form-group">
					<label class="form-label">Nom *</label><input class="form-input" type="text" name="nom" required></div>
				<div class="form-group">
					<label class="form-label">Type *</label>
					<select class="form-select" name="type" required>
						<option value="">Sélectionner...</option>
						<option value="EOLIEN">Éolien</option>
						<option value="SOLAIRE">Solaire</option>
						<option value="HYDRAULIQUE">Hydraulique</option>
						<option value="HYDROGENE">Hydrogène</option>
						<option value="RESEAU">Réseau</option>
					</select>
				</div>
				<div class="form-group">
					<label class="form-label">Coût de production (€/MWh)</label><input class="form-input" type="number" step="0.01" min="0" name="coutProduction" placeholder="45.00"></div>
					<div class="form-group">
						<label class="form-label">Capacité max de stockage (MWh)</label><input class="form-input" type="number" step="0.01" min="0" name="capaciteMax" placeholder="1000"></div>
				<div class="form-group">
					<label class="form-label">Couleur</label><input class="form-input" type="color" name="couleur" value="#4F8AFF"></div>
				<div class="form-actions">
					<button type="submit" class="btn btn-primary btn-full">Ajouter</button>
					<button type="button" class="btn btn-ghost btn-full" data-modal-close="modal-source-add">Annuler</button>
				</div>
			</form>
		</div>
	</div>

	<!-- Modal Édition source -->
	{# action="" est rempli dynamiquement par data-action du bouton "Modifier" cliqué. #}
	<div id="modal-source-edit" class="modal-backdrop">
		<div class="modal">
			<h3 class="modal__title">Modifier la source</h3>
			<form id="form-source-edit" method="POST" action="">
				<div class="form-group">
					<label class="form-label">Nom *</label><input class="form-input" type="text" id="edit-s-nom" name="nom" required></div>
				<div class="form-group">
					<label class="form-label">Type *</label>
					<select class="form-select" id="edit-s-type" name="type" required>
						<option value="EOLIEN">Éolien</option>
						<option value="SOLAIRE">Solaire</option>
						<option value="HYDRAULIQUE">Hydraulique</option>
						<option value="HYDROGENE">Hydrogène</option>
						<option value="RESEAU">Réseau</option>
					</select>
				</div>
				<div class="form-group">
					<label class="form-label">Coût de production (€/MWh)</label><input class="form-input" type="number" step="0.01" min="0" id="edit-s-cout" name="coutProduction"></div>
					<div class="form-group">
						<label class="form-label">Capacité max de stockage (MWh)</label><input class="form-input" type="number" step="0.01" min="0" id="edit-s-cap" name="capaciteMax"></div>
				<div class="form-group">
					<label class="form-label">Couleur</label><input class="form-input" type="color" id="edit-s-couleur" name="couleur"></div>
				<div class="form-group">
					<label class="form-label">Actif</label>
					<label class="toggle"><input type="checkbox" id="edit-s-actif" name="actif"><span class="toggle__track"></span>
						<span class="toggle__thumb"></span>
					</label>
				</div>
				<div class="form-actions">
					<button type="submit" class="btn btn-primary btn-full">Modifier</button>
					<button type="button" class="btn btn-ghost btn-full" data-modal-close="modal-source-edit">Annuler</button>
				</div>
			</form>
		</div>
	</div>

	<!-- Modal Suppression source -->
	<div id="modal-source-delete" class="modal-backdrop">
		<div class="modal">
			<h3 class="modal__title">Supprimer la source</h3>
			<p id="delete-source-text" class="modal__confirm-text"></p>
			<form id="form-source-delete" method="POST" action="">
				<div class="form-actions">
					<button type="submit" class="btn btn-danger btn-full">Supprimer</button>
					<button type="button" class="btn btn-ghost btn-full" data-modal-close="modal-source-delete">Annuler</button>
				</div>
			</form>
		</div>
	</div>

	<!-- Modal Seuil -->
	<div id="modal-seuil-add" class="modal-backdrop">
		<div class="modal">
			<h3 class="modal__title">Configurer un seuil</h3>
			<form method="POST" action="/energie/seuils/save">
				<div class="form-group">
					<label class="form-label">Source *</label>
					<select class="form-select" name="sourceId" required>
						<option value="">Sélectionner...</option>
						{% for s in sources %}
							<option value="{{ s.id }}">{{ s.nom }}
								({{ s.type }})</option>
						{% endfor %}
					</select>
				</div>
				<div class="form-group">
					<label class="form-label">Seuil déclenchement (% mix national)</label>
					<input class="form-input" type="number" step="1" name="seuilDeclenchement" placeholder="20" min="0" max="100">
				</div>
				<div class="form-group">
					<label class="form-label">Seuil arrêt + vente (% mix national)</label>
					<input class="form-input" type="number" step="1" name="seuilArret" placeholder="10" min="0" max="100">
				</div>
				{# Interrupteur réel (modifiable) qui active l'automatisation horaire pour cette source. #}
				<div class="declenchement-block">
					<div class="declenchement-block__header">
						<span class="declenchement-block__title">Déclenchement automatique</span>
						<label class="toggle"><input type="checkbox" name="declenchementAuto"><span class="toggle__track"></span>
							<span class="toggle__thumb"></span>
						</label>
					</div>
					<p class="declenchement-block__desc">Production et vente se déclenchent automatiquement chaque heure selon le mix ENTSO-E.</p>
				</div>
				<div class="form-actions">
					<button type="submit" class="btn btn-primary btn-full">Enregistrer</button>
					<button type="button" class="btn btn-ghost btn-full" data-modal-close="modal-seuil-add">Annuler</button>
				</div>
			</form>
		</div>
	</div>

	<!-- Modal Suppression seuil -->
	<div id="modal-seuil-delete" class="modal-backdrop">
		<div class="modal">
			<h3 class="modal__title">Supprimer le seuil</h3>
			<p id="delete-seuil-text" class="modal__confirm-text"></p>
			<form id="form-seuil-delete" method="POST" action="">
				<div class="form-actions">
					<button type="submit" class="btn btn-danger btn-full">Supprimer</button>
					<button type="button" class="btn btn-ghost btn-full" data-modal-close="modal-seuil-delete">Annuler</button>
				</div>
			</form>
		</div>
	</div>

{% endblock %}

{% block script %}
{# Chart.js (librairie de graphiques, chargée depuis un CDN) puis notre script de page. #}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
<script src="/script/energie.js"></script>
{% endblock %}
