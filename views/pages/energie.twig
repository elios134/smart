{% extends "layouts/base.twig" %}

{% block style %}
<link rel="stylesheet" href="/css/energie.css">
{% endblock %}

{% block header %}
    {% include "partials/_navbar.twig" %}
{% endblock %}

{% block main %}
<div class="main">

    {% if flash.success %}<div class="toast toast-success">✓ {{ flash.success }}</div>{% endif %}
    {% if flash.error %}<div class="toast toast-error">✕ {{ flash.error }}</div>{% endif %}

    <script id="energie-mix-data" type="application/json">{{ mix|raw }}</script>

    <!-- KPIs -->
    <div class="stats-grid energie-stats">
        <div class="stat-card">
            <div class="stat-card__value">{{ stockTotal }}</div>
            <div class="stat-card__label">MWh stockés</div>
        </div>
        <div class="stat-card">
            <div class="stat-card__value">{{ prodEnCours }}</div>
            <div class="stat-card__label">Productions en cours</div>
        </div>
        <div class="stat-card">
            <div class="stat-card__value">{{ caTotal }}</div>
            <div class="stat-card__label">CA ventes (€)</div>
        </div>
    </div>

    {% if alertes %}
    <div class="energie-alertes">
        {% for a in alertes %}
        <div class="alerte-card alerte-card--vente">
            <div>
                <div class="alerte-card__badge">Alerte vente</div>
                <div class="alerte-card__name">{{ a.source.nom }}</div>
                <div class="alerte-card__sub">Mix national {{ a.source.type }} : {{ a.mixPct }}% — sous le seuil d'arrêt</div>
            </div>
            <span class="badge badge-red">VENDRE</span>
        </div>
        {% endfor %}
    </div>
    {% endif %}

    <!-- Onglets -->
    <div class="page-tabs">
        <a class="page-tab active" data-tab="dashboard" href="#">Tableau de bord</a>
        <a class="page-tab" data-tab="production" href="#">Productions</a>
        <a class="page-tab" data-tab="ventes" href="#">Ventes</a>
        <a class="page-tab" data-tab="config" href="#">Configuration</a>
    </div>

    <!-- ── TAB DASHBOARD ── -->
    <div id="tab-dashboard" class="tab-panel active">

        <!-- Mix ENTSO-E -->
        <div class="card">
            <div class="card__header">
                <span class="card__title">Mix Production National — France</span>
                {% if mixObj %}
                    <span class="badge badge-green">LIVE ENTSO-E</span>
                {% else %}
                    <span class="badge badge-muted">API non configurée</span>
                {% endif %}
            </div>
            {% if mixObj %}
            <div class="mix-grid">
                {% if mixObj.EOLIEN is defined %}
                <div class="mix-card mix-card--eolien">
                    <div class="mix-card__label">Éolien</div>
                    <div class="mix-card__value">{{ mixObj.EOLIEN }}%</div>
                    <div class="mix-bar"><div class="mix-bar__fill" style="width:{{ mixObj.EOLIEN }}%;background:#4F8AFF;"></div></div>
                </div>
                {% endif %}
                {% if mixObj.SOLAIRE is defined %}
                <div class="mix-card mix-card--solaire">
                    <div class="mix-card__label">Solaire</div>
                    <div class="mix-card__value">{{ mixObj.SOLAIRE }}%</div>
                    <div class="mix-bar"><div class="mix-bar__fill" style="width:{{ mixObj.SOLAIRE }}%;background:#F5C518;"></div></div>
                </div>
                {% endif %}
                {% if mixObj.HYDRAULIQUE is defined %}
                <div class="mix-card mix-card--hydraulique">
                    <div class="mix-card__label">Hydraulique</div>
                    <div class="mix-card__value">{{ mixObj.HYDRAULIQUE }}%</div>
                    <div class="mix-bar"><div class="mix-bar__fill" style="width:{{ mixObj.HYDRAULIQUE }}%;background:#2FEEA8;"></div></div>
                </div>
                {% endif %}
                {% if mixObj.NUCLEAIRE is defined %}
                <div class="mix-card">
                    <div class="mix-card__label">Nucléaire</div>
                    <div class="mix-card__value">{{ mixObj.NUCLEAIRE }}%</div>
                    <div class="mix-bar"><div class="mix-bar__fill" style="width:{{ mixObj.NUCLEAIRE }}%;background:#5A6380;"></div></div>
                </div>
                {% endif %}
            </div>
            <div class="mix-meta">Total réseau : {{ mixObj._totalMW }} MW — {{ mixObj._fetchedAt }}</div>
            {% else %}
            <p class="empty-state">Configurez ENTSOE_API_KEY dans votre .env pour activer les données temps réel</p>
            {% endif %}
        </div>

        <!-- Sources configurées -->
        <div class="card">
            <div class="card__header">
                <span class="card__title">Mes Sources d'Énergie</span>
                {% if userRole == 'SUPER_ADMIN' or userRole == 'ADMIN' %}
                <button class="btn btn-primary" data-modal-open="modal-source-add">Ajouter une source</button>
                {% endif %}
            </div>
            <table>
                <thead>
                    <tr>
                        <th>Source</th><th>Type</th><th>Coût prod.</th>
                        <th>Mix actuel</th><th>Stock</th><th>Statut</th>
                        {% if userRole == 'SUPER_ADMIN' or userRole == 'ADMIN' %}<th>Actions</th>{% endif %}
                    </tr>
                </thead>
                <tbody>
                    {% for s in sources %}
                    <tr>
                        <td><span class="source-dot" style="background:{{ s.couleur }};"></span> {{ s.nom }}</td>
                        <td><span class="badge badge-blue">{{ s.type }}</span></td>
                        <td>{{ s.coutProduction }} €/MWh</td>
                        <td>
                            {% if mixObj and attribute(mixObj, s.type) is defined %}
                                <span class="badge {% if attribute(mixObj, s.type) >= 20 %}badge-green{% elseif attribute(mixObj, s.type) >= 10 %}badge-blue{% else %}badge-red{% endif %}">
                                    {{ attribute(mixObj, s.type) }}%
                                </span>
                            {% else %}
                                <span class="badge badge-muted">—</span>
                            {% endif %}
                        </td>
                        <td>{{ s.stock.quantite ?? 0 }} MWh</td>
                        <td>
                            {% if s.actif %}
                                <span class="badge badge-green">ACTIF</span>
                            {% else %}
                                <span class="badge badge-muted">INACTIF</span>
                            {% endif %}
                        </td>
                        {% if userRole == 'SUPER_ADMIN' or userRole == 'ADMIN' %}
                        <td>
                            <button class="btn btn-outline"
                                data-modal-open="modal-source-edit"
                                data-form="form-source-edit"
                                data-action="/energie/sources/{{ s.id }}/edit"
                                data-fields='{"edit-s-nom":"{{ s.nom }}","edit-s-cout":"{{ s.coutProduction }}","edit-s-couleur":"{{ s.couleur }}"}'>
                                Modifier
                            </button>
                            {% if userRole == 'SUPER_ADMIN' %}
                            <button class="btn btn-danger"
                                data-modal-open="modal-source-delete"
                                data-form="form-source-delete"
                                data-action="/energie/sources/{{ s.id }}/delete"
                                data-confirm-text="Supprimer {{ s.nom }} ?"
                                data-confirm-target="delete-source-text">
                                Supprimer
                            </button>
                            {% endif %}
                        </td>
                        {% endif %}
                    </tr>
                    {% else %}
                    <tr><td colspan="7" class="empty-state">Aucune source configurée</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

    </div>

    <!-- ── TAB PRODUCTION ── -->
    <div id="tab-production" class="tab-panel">
        <div class="card">
            <div class="card__header">
                <span class="card__title">Productions</span>
                <button class="btn btn-primary" data-modal-open="modal-prod-add">Lancer une production</button>
            </div>
            <table>
                <thead>
                    <tr>
                        <th>Source</th><th>Quantité (MWh)</th><th>Coût total</th>
                        <th>Début</th><th>Fin</th><th>Déclenchement</th><th>Statut</th>
                        {% if userRole == 'SUPER_ADMIN' or userRole == 'ADMIN' %}<th>Actions</th>{% endif %}
                    </tr>
                </thead>
                <tbody>
                    {% for p in productions %}
                    <tr>
                        <td>{{ p.source.nom }}</td>
                        <td>{{ p.quantite }} MWh</td>
                        <td>{{ p.coutTotal }} €</td>
                        <td>{{ p.debutProd|date('d/m/Y H:i') }}</td>
                        <td>{{ p.finProd ? p.finProd|date('d/m/Y H:i') : '—' }}</td>
                        <td>
                            {% if p.declenchement == 'AUTO' %}
                                <span class="badge badge-blue">AUTO</span>
                            {% else %}
                                <span class="badge badge-muted">MANUEL</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if p.statut == 'EN_COURS' %}
                                <span class="badge badge-green">EN COURS</span>
                            {% elseif p.statut == 'TERMINEE' %}
                                <span class="badge badge-muted">TERMINÉE</span>
                            {% else %}
                                <span class="badge badge-red">ANNULÉE</span>
                            {% endif %}
                        </td>
                        {% if userRole == 'SUPER_ADMIN' or userRole == 'ADMIN' %}
                        <td>
                            {% if p.statut == 'EN_COURS' %}
                            <form method="POST" action="/energie/productions/{{ p.id }}/terminer">
                                <button type="submit" class="btn btn-primary">Terminer</button>
                            </form>
                            {% endif %}
                            <button class="btn btn-danger"
                                data-modal-open="modal-prod-delete"
                                data-form="form-prod-delete"
                                data-action="/energie/productions/{{ p.id }}/delete"
                                data-confirm-text="Supprimer cette production ?"
                                data-confirm-target="delete-prod-text">
                                Supprimer
                            </button>
                        </td>
                        {% endif %}
                    </tr>
                    {% else %}
                    <tr><td colspan="8" class="empty-state">Aucune production enregistrée</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <!-- ── TAB VENTES ── -->
    <div id="tab-ventes" class="tab-panel">
        <div class="card">
            <div class="card__header">
                <span class="card__title">Ventes d'énergie</span>
                {% if userRole == 'SUPER_ADMIN' or userRole == 'ADMIN' %}
                <button class="btn btn-primary" data-modal-open="modal-vente-add">Nouvelle vente</button>
                {% endif %}
            </div>
            <table>
                <thead>
                    <tr>
                        <th>Source</th><th>Quantité (MWh)</th><th>Prix (€/MWh)</th><th>Total</th><th>Date</th>
                    </tr>
                </thead>
                <tbody>
                    {% for v in ventes %}
                    <tr>
                        <td>{{ v.source.nom }}</td>
                        <td>{{ v.quantite }} MWh</td>
                        <td>{{ v.prixVente }} €</td>
                        <td>{{ v.total }} €</td>
                        <td>{{ v.createdAt|date('d/m/Y H:i') }}</td>
                    </tr>
                    {% else %}
                    <tr><td colspan="5" class="empty-state">Aucune vente enregistrée</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <!-- ── TAB CONFIG ── -->
    <div id="tab-config" class="tab-panel">
        <div class="card">
            <div class="card__header">
                <span class="card__title">Seuils de déclenchement</span>
                {% if userRole == 'SUPER_ADMIN' or userRole == 'ADMIN' %}
                <button class="btn btn-primary" data-modal-open="modal-seuil-add">Configurer un seuil</button>
                {% endif %}
            </div>
            <p class="energie-config-desc">
                Définissez pour chaque source le % du mix national ENTSO-E qui déclenche/arrête la production automatiquement.
            </p>
            <table>
                <thead>
                    <tr>
                        <th>Source</th><th>Seuil déclenchement</th><th>Seuil arrêt</th>
                        <th>Déclenchement auto</th><th>Statut</th>
                        {% if userRole == 'SUPER_ADMIN' or userRole == 'ADMIN' %}<th>Actions</th>{% endif %}
                    </tr>
                </thead>
                <tbody>
                    {% for s in seuils %}
                    <tr>
                        <td>{{ s.source.nom }}</td>
                        <td>
                            <span class="taux-pill taux-pill--achat">
                                {{ s.seuilDeclenchement }}%
                            </span>
                        </td>
                        <td>
                            <span class="taux-pill taux-pill--vente">
                                {{ s.seuilArret }}%
                            </span>
                        </td>
                        <td>
                            <label class="toggle">
                                <input type="checkbox" {% if s.declenchementAuto %}checked{% endif %} disabled>
                                <span class="toggle__track"></span>
                                <span class="toggle__thumb"></span>
                            </label>
                        </td>
                        <td>
                            {% if s.statut == 'ACTIF' %}
                                <span class="badge badge-green">ACTIF</span>
                            {% else %}
                                <span class="badge badge-muted">INACTIF</span>
                            {% endif %}
                        </td>
                        {% if userRole == 'SUPER_ADMIN' or userRole == 'ADMIN' %}
                        <td>
                            <button class="btn btn-danger"
                                data-modal-open="modal-seuil-delete"
                                data-form="form-seuil-delete"
                                data-action="/energie/seuils/{{ s.id }}/delete"
                                data-confirm-text="Supprimer le seuil de {{ s.source.nom }} ?"
                                data-confirm-target="delete-seuil-text">
                                Supprimer
                            </button>
                        </td>
                        {% endif %}
                    </tr>
                    {% else %}
                    <tr><td colspan="6" class="empty-state">Aucun seuil configuré</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

</div>

<!-- ── MODALES ── -->

<!-- Ajout source -->
<div id="modal-source-add" class="modal-backdrop">
    <div class="modal">
        <h3 class="modal__title">Ajouter une source d'énergie</h3>
        <form method="POST" action="/energie/sources/add">
            <div class="form-group">
                <label class="form-label">Nom *</label>
                <input class="form-input" type="text" name="nom" placeholder="Parc éolien Nord" required>
            </div>
            <div class="form-group">
                <label class="form-label">Type *</label>
                <select class="form-select" name="type" required>
                    <option value="">Sélectionner...</option>
                    <option value="EOLIEN">Éolien</option>
                    <option value="SOLAIRE">Solaire</option>
                    <option value="HYDRAULIQUE">Hydraulique</option>
                    <option value="HYDROGENE">Hydrogène</option>
                    <option value="RESEAU">Réseau</option>
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">Coût de production (€/MWh)</label>
                <input class="form-input" type="number" step="0.01" name="coutProduction" placeholder="45.00">
            </div>
            <div class="form-group">
                <label class="form-label">Couleur</label>
                <input class="form-input" type="color" name="couleur" value="#4F8AFF">
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary btn-full">Ajouter</button>
                <button type="button" class="btn btn-ghost btn-full" data-modal-close="modal-source-add">Annuler</button>
            </div>
        </form>
    </div>
</div>

<!-- Édition source -->
<div id="modal-source-edit" class="modal-backdrop">
    <div class="modal">
        <h3 class="modal__title">Modifier la source</h3>
        <form id="form-source-edit" method="POST" action="">
            <div class="form-group">
                <label class="form-label">Nom *</label>
                <input class="form-input" type="text" id="edit-s-nom" name="nom" required>
            </div>
            <div class="form-group">
                <label class="form-label">Type *</label>
                <select class="form-select" name="type" required>
                    <option value="EOLIEN">Éolien</option>
                    <option value="SOLAIRE">Solaire</option>
                    <option value="HYDRAULIQUE">Hydraulique</option>
                    <option value="HYDROGENE">Hydrogène</option>
                    <option value="RESEAU">Réseau</option>
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">Coût de production (€/MWh)</label>
                <input class="form-input" type="number" step="0.01" id="edit-s-cout" name="coutProduction">
            </div>
            <div class="form-group">
                <label class="form-label">Couleur</label>
                <input class="form-input" type="color" id="edit-s-couleur" name="couleur">
            </div>
            <div class="form-group">
                <label class="form-label">Actif</label>
                <label class="toggle">
                    <input type="checkbox" name="actif" checked>
                    <span class="toggle__track"></span>
                    <span class="toggle__thumb"></span>
                </label>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary btn-full">Modifier</button>
                <button type="button" class="btn btn-ghost btn-full" data-modal-close="modal-source-edit">Annuler</button>
            </div>
        </form>
    </div>
</div>

<!-- Suppression source -->
<div id="modal-source-delete" class="modal-backdrop">
    <div class="modal">
        <h3 class="modal__title">Supprimer la source</h3>
        <p id="delete-source-text" class="modal__confirm-text"></p>
        <form id="form-source-delete" method="POST" action="">
            <div class="form-actions">
                <button type="submit" class="btn btn-danger btn-full">Supprimer</button>
                <button type="button" class="btn btn-ghost btn-full" data-modal-close="modal-source-delete">Annuler</button>
            </div>
        </form>
    </div>
</div>

<!-- Ajout production -->
<div id="modal-prod-add" class="modal-backdrop">
    <div class="modal">
        <h3 class="modal__title">Lancer une production</h3>
        <form method="POST" action="/energie/productions/add">
            <div class="form-group">
                <label class="form-label">Source *</label>
                <select class="form-select" name="sourceId" required>
                    <option value="">Sélectionner...</option>
                    {% for s in sources %}
                        {% if s.actif %}
                        <option value="{{ s.id }}">{{ s.nom }} ({{ s.type }})</option>
                        {% endif %}
                    {% endfor %}
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">Quantité produite (MWh)</label>
                <input class="form-input" type="number" step="0.01" name="quantite" placeholder="100">
            </div>
            <div class="form-group">
                <label class="form-label">Coût total (€)</label>
                <input class="form-input" type="number" step="0.01" name="coutTotal" placeholder="4500">
            </div>
            <div class="modal-grid-2">
                <div class="form-group">
                    <label class="form-label">Début</label>
                    <input class="form-input" type="datetime-local" name="debutProd">
                </div>
                <div class="form-group">
                    <label class="form-label">Fin (optionnel)</label>
                    <input class="form-input" type="datetime-local" name="finProd">
                </div>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary btn-full">Lancer</button>
                <button type="button" class="btn btn-ghost btn-full" data-modal-close="modal-prod-add">Annuler</button>
            </div>
        </form>
    </div>
</div>

<!-- Suppression production -->
<div id="modal-prod-delete" class="modal-backdrop">
    <div class="modal">
        <h3 class="modal__title">Supprimer la production</h3>
        <p id="delete-prod-text" class="modal__confirm-text"></p>
        <form id="form-prod-delete" method="POST" action="">
            <div class="form-actions">
                <button type="submit" class="btn btn-danger btn-full">Supprimer</button>
                <button type="button" class="btn btn-ghost btn-full" data-modal-close="modal-prod-delete">Annuler</button>
            </div>
        </form>
    </div>
</div>

<!-- Ajout vente -->
<div id="modal-vente-add" class="modal-backdrop">
    <div class="modal">
        <h3 class="modal__title">Enregistrer une vente</h3>
        <form method="POST" action="/energie/ventes/add">
            <div class="form-group">
                <label class="form-label">Source *</label>
                <select class="form-select" id="vente-sourceId" name="sourceId" required>
                    <option value="">Sélectionner...</option>
                    {% for s in sources %}
                    <option value="{{ s.id }}" data-stock="{{ s.stock.quantite ?? 0 }}">
                        {{ s.nom }} — stock : {{ s.stock.quantite ?? 0 }} MWh
                    </option>
                    {% endfor %}
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">Quantité (MWh) *</label>
                <input class="form-input" type="number" step="0.01" id="vente-quantite" name="quantite" placeholder="50" required>
            </div>
            <div class="form-group">
                <label class="form-label">Prix de vente (€/MWh) *</label>
                <input class="form-input" type="number" step="0.01" id="vente-prix" name="prixVente" placeholder="80" required>
            </div>
            <div class="total-estime">
                <span>Total estimé</span>
                <span class="total-estime__value" id="vente-total-estime">0 €</span>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary btn-full">Valider la vente</button>
                <button type="button" class="btn btn-ghost btn-full" data-modal-close="modal-vente-add">Annuler</button>
            </div>
        </form>
    </div>
</div>

<!-- Config seuil -->
<div id="modal-seuil-add" class="modal-backdrop">
    <div class="modal">
        <h3 class="modal__title">Configurer un seuil</h3>
        <form method="POST" action="/energie/seuils/save">
            <div class="form-group">
                <label class="form-label">Source *</label>
                <select class="form-select" name="sourceId" required>
                    <option value="">Sélectionner...</option>
                    {% for s in sources %}
                    <option value="{{ s.id }}">{{ s.nom }} ({{ s.type }})</option>
                    {% endfor %}
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">Seuil déclenchement production (% mix national)</label>
                <input class="form-input" type="number" step="1" name="seuilDeclenchement" placeholder="20" min="0" max="100">
                <p class="energie-field-hint">Si le type de source atteint ce % du mix national → lancer production</p>
            </div>
            <div class="form-group">
                <label class="form-label">Seuil arrêt + vente (% mix national)</label>
                <input class="form-input" type="number" step="1" name="seuilArret" placeholder="10" min="0" max="100">
                <p class="energie-field-hint">Si le % descend sous ce seuil → stopper production et vendre le stock</p>
            </div>
            <div class="declenchement-block">
                <div class="declenchement-block__header">
                    <span class="declenchement-block__title">Déclenchement automatique</span>
                    <label class="toggle">
                        <input type="checkbox" name="declenchementAuto">
                        <span class="toggle__track"></span>
                        <span class="toggle__thumb"></span>
                    </label>
                </div>
                <p class="declenchement-block__desc">La production et la vente se déclencheront automatiquement chaque heure selon le mix ENTSO-E.</p>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary btn-full">Enregistrer</button>
                <button type="button" class="btn btn-ghost btn-full" data-modal-close="modal-seuil-add">Annuler</button>
            </div>
        </form>
    </div>
</div>

<!-- Suppression seuil -->
<div id="modal-seuil-delete" class="modal-backdrop">
    <div class="modal">
        <h3 class="modal__title">Supprimer le seuil</h3>
        <p id="delete-seuil-text" class="modal__confirm-text"></p>
        <form id="form-seuil-delete" method="POST" action="">
            <div class="form-actions">
                <button type="submit" class="btn btn-danger btn-full">Supprimer</button>
                <button type="button" class="btn btn-ghost btn-full" data-modal-close="modal-seuil-delete">Annuler</button>
            </div>
        </form>
    </div>
</div>

{% endblock %}

