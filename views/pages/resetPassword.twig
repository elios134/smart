{% extends 'layouts/base.twig' %}

{% block header %}
{% include 'partials/_navbar.twig' %}
{% endblock %}

{% block main %}
<div class="main">

  {% if flash.success %}
  <div class="toast-container">
    <div class="toast toast-success">✓ {{ flash.success }}</div>
  </div>
  {% endif %}
  {% if flash.error %}
  <div class="toast-container">
    <div class="toast toast-error">✕ {{ flash.error }}</div>
  </div>
  {% endif %}

  <a href="/profil" class="section-label">← Retour au profil</a>

  <div style="max-width:480px;">
    <div class="card">
      <div class="card__header">
        <span class="card__title">Réinitialiser le mot de passe</span>
      </div>
      <form method="POST" action="/reset-password">
        <div class="form-group">
          <label class="form-label">MOT DE PASSE ACTUEL</label>
          <input class="form-input" type="password" name="currentPassword"
            placeholder="••••••••" required>
        </div>
        <div class="form-group">
          <label class="form-label">NOUVEAU MOT DE PASSE</label>
          <input class="form-input" type="password" name="newPassword"
            placeholder="Min. 8 caractères" required minlength="8">
        </div>
        <div class="form-group">
          <label class="form-label">CONFIRMER LE NOUVEAU MOT DE PASSE</label>
          <input class="form-input" type="password" name="confirmPassword"
            placeholder="••••••••" required minlength="8">
        </div>
        <div class="form-actions" style="margin-top:12px;">
          <button type="submit" class="btn btn-primary btn-full">Changer le mot de passe</button>
          <a href="/profil" class="btn btn-ghost btn-full" style="text-align:center;">Annuler</a>
        </div>
      </form>
    </div>
  </div>
</div>
{% endblock %}
