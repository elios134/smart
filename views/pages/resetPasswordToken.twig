{% extends 'layouts/base.twig' %}

{% block style %}
<link rel="stylesheet" href="/css/login.css">
{% endblock %}

{% block main %}
<div class="login-page">
  <div class="login-card">
    <h1 class="login-card__title">Nouveau mot de passe</h1>

    {% if error is defined and error %}
    <div class="toast toast-error" style="margin-bottom:20px;">✕ {{ error }}</div>
    {% endif %}

    {% if token %}
    <form method="POST" action="/reset-password/{{ token }}">
      <div class="form-group">
        <label class="form-label">Nouveau mot de passe</label>
        <div class="input-password-wrap">
          <input class="form-input" type="password" name="newPassword" placeholder="Min. 8 caractères" required minlength="8" autofocus>
          <button type="button" class="btn-toggle"><img src="/imgs/visibility-off.svg" alt="Afficher"></button>
        </div>
      </div>
      <div class="form-group">
        <label class="form-label">Confirmer le mot de passe</label>
        <div class="input-password-wrap">
          <input class="form-input" type="password" name="confirmPassword" placeholder="••••••••" required minlength="8">
          <button type="button" class="btn-toggle"><img src="/imgs/visibility-off.svg" alt="Afficher"></button>
        </div>
      </div>
      <button type="submit" class="btn btn-primary btn-full" style="margin-top:8px;">Réinitialiser</button>
    </form>
    {% else %}
    <p style="color:var(--muted);text-align:center;padding:24px 0;">Ce lien est invalide ou a expiré.</p>
    <a href="/forgot-password" class="btn btn-outline btn-full" style="text-align:center;">Demander un nouveau lien</a>
    {% endif %}

    <div class="login-card__links">
      <a href="/login">Retour à la connexion</a>
    </div>
  </div>
</div>
{% endblock %}
