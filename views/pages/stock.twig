{% extends "layouts/base.twig" %}

{% block header %}
    {% include "partials/_navbar.twig" %}
{% endblock %}

{% block main %}
<div class="main">

    {% if flash.success %}<div class="toast toast-success">✓ {{ flash.success }}</div>{% endif %}
    {% if flash.error %}<div class="toast toast-error">✕ {{ flash.error }}</div>{% endif %}

    <a href="/fournisseurs" class="section-label"><i class="ti ti-users"></i> FOURNISSEURS</a>

    <!-- ═══ Stock MWh par source ═══ -->
    <div class="card">
        <div class="card__header">
            <span class="card__title">Stock d'énergie par source</span>
            {% if userRole != 'OPERATEUR' %}
            <button class="btn btn-primary" data-modal-open="modal-achat-add"><i class="ti ti-plus"></i> Enregistrer un achat</button>
            {% endif %}
        </div>
        <table class="table--sm-hide-2-4">
            <thead>
                <tr>
                    <th>Source</th><th>Type</th><th>Stock (MWh)</th><th>Remplissage</th>
                    <th>Coût prod. (€/MWh)</th><th>Valeur stock (€)</th>
                    {% if userRole != 'OPERATEUR' %}<th>Ajuster</th>{% endif %}
                </tr>
            </thead>
            <tbody>
                {% for s in sources %}
                <tr>
                    <td>{{ s.nom }}</td>
                    <td><span class="badge badge-blue">{{ s.type }}</span></td>
                    <td><strong>{{ s.stock.quantite ?? 0 }}</strong></td>
                    <td>
                        {% if s.capaciteMax and s.capaciteMax > 0 %}
                            {% set pct = ((s.stock.quantite ?? 0) / s.capaciteMax * 100)|round %}
                            {% if pct > 100 %}{% set pct = 100 %}{% endif %}
                            <div style="display:flex;align-items:center;gap:8px;min-width:100px;">
                                <div style="flex:1;height:7px;background:var(--bg);border-radius:6px;overflow:hidden;">
                                    <div style="width:{{ pct }}%;height:100%;border-radius:6px;background:{% if pct >= 50 %}var(--green){% elseif pct >= 20 %}var(--color-warning){% else %}var(--red){% endif %};"></div>
                                </div>
                                <span style="font-size:12px;color:var(--muted);">{{ pct }}%</span>
                            </div>
                        {% else %}
                            {% if userRole != 'OPERATEUR' %}<a href="/energie" class="link" title="Définir une capacité max sur la source">définir</a>{% else %}<span class="badge badge-muted">—</span>{% endif %}
                        {% endif %}
                    </td>
                    <td>{{ s.coutProduction }} €</td>
                    <td>{{ ((s.stock.quantite ?? 0) * s.coutProduction)|round(2) }} €</td>
                    {% if userRole != 'OPERATEUR' %}
                    <td>
                        <button class="btn btn-outline"
                            data-modal-open="modal-ajuster"
                            data-form="form-ajuster"
                            data-action="/stock/ajuster/{{ s.id }}"
                            data-fields='{"ajuster-source-nom":"{{ s.nom }}"}'
                            data-confirm-target="ajuster-source-label">
                            Ajuster
                        </button>
                    </td>
                    {% endif %}
                </tr>
                {% else %}
                <tr><td colspan="7" class="empty-state">Aucune source — <a href="/energie" class="card__link">En configurer une →</a></td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <!-- ═══ Historique des achats ═══ -->
    <div class="card">
        <div class="card__header">
            <span class="card__title">Historique des achats</span>
            <a href="/planification" class="card__link">Voir les sessions →</a>
        </div>
        <table class="table--sm-hide-2-4-6">
            <thead>
                <tr>
                    <th>Source</th><th>Fournisseur</th><th>Quantité (MWh)</th>
                    <th>Prix achat (€/MWh)</th><th>Total (€)</th><th>Date</th>
                    {% if userRole == 'SUPER_ADMIN' %}<th>Actions</th>{% endif %}
                </tr>
            </thead>
            <tbody>
                {% for a in achats %}
                <tr>
                    <td>{{ a.source.nom }}</td>
                    <td>{{ a.tiers ? a.tiers.nom : '—' }}</td>
                    <td>{{ a.quantite }} MWh</td>
                    <td>{{ a.prixAchat }} €</td>
                    <td>{{ a.total }} €</td>
                    <td>{{ a.createdAt|date('d/m/Y H:i') }}</td>
                    {% if userRole == 'SUPER_ADMIN' %}
                    <td>
                        <button class="btn btn-danger"
                            data-modal-open="modal-achat-delete"
                            data-form="form-achat-delete"
                            data-action="/stock/achats/{{ a.id }}/delete"
                            data-confirm-text="Supprimer cet achat de {{ a.quantite }} MWh ({{ a.source.nom }}) ? Le stock sera réduit d'autant."
                            data-confirm-target="delete-achat-text">
                            Supprimer
                        </button>
                    </td>
                    {% endif %}
                </tr>
                {% else %}
                <tr><td colspan="7" class="empty-state">Aucun achat enregistré</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

</div>

{% if userRole != 'OPERATEUR' %}
<!-- Modal Achat énergie -->
<div id="modal-achat-add" class="modal-backdrop">
    <div class="modal">
        <h3 class="modal__title">Enregistrer un achat d'énergie</h3>
        <form method="POST" action="/stock/achats/add">
            <div class="form-group">
                <label class="form-label">Source *</label>
                <select class="form-select" name="sourceId" required>
                    <option value="">Sélectionner...</option>
                    {% for s in sources %}
                    <option value="{{ s.id }}">{{ s.nom }} ({{ s.type }})</option>
                    {% endfor %}
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">Fournisseur</label>
                <select class="form-select" name="tiersId">
                    <option value="">Aucun</option>
                    {% for f in fournisseurs %}
                    <option value="{{ f.id }}">{{ f.nom }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">Quantité (MWh) *</label>
                <input class="form-input" type="number" step="0.01" min="0"id="achat-quantite" name="quantite" placeholder="100" required>
            </div>
            <div class="form-group">
                <label class="form-label">Prix d'achat (€/MWh) *</label>
                <input class="form-input" type="number" step="0.01" min="0"id="achat-prix" name="prixAchat" placeholder="45" required>
            </div>
            <div class="total-estime">
                <span>Total estimé</span>
                <span class="total-estime__value" id="achat-total-estime">0 €</span>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary btn-full">Enregistrer</button>
                <button type="button" class="btn btn-ghost btn-full" data-modal-close="modal-achat-add">Annuler</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Ajuster stock -->
<div id="modal-ajuster" class="modal-backdrop">
    <div class="modal">
        <h3 class="modal__title">Ajuster le stock</h3>
        <p class="modal__confirm-text">Source : <strong id="ajuster-source-label"></strong></p>
        <form id="form-ajuster" method="POST" action="">
            <div class="form-group">
                <label class="form-label">Opération</label>
                <select class="form-select" name="sens" required>
                    <option value="ajouter">Ajouter des MWh</option>
                    <option value="retirer">Retirer des MWh</option>
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">Quantité (MWh) *</label>
                <input class="form-input" type="number" step="0.01" min="0"name="quantite" placeholder="50" required>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary btn-full">Confirmer</button>
                <button type="button" class="btn btn-ghost btn-full" data-modal-close="modal-ajuster">Annuler</button>
            </div>
        </form>
    </div>
</div>
{% endif %}

<!-- Modal Suppression achat -->
<div id="modal-achat-delete" class="modal-backdrop">
    <div class="modal">
        <h3 class="modal__title">Supprimer l'achat</h3>
        <p id="delete-achat-text" class="modal__confirm-text"></p>
        <form id="form-achat-delete" method="POST" action="">
            <div class="form-actions">
                <button type="submit" class="btn btn-danger btn-full">Supprimer</button>
                <button type="button" class="btn btn-ghost btn-full" data-modal-close="modal-achat-delete">Annuler</button>
            </div>
        </form>
    </div>
</div>

{% endblock %}

{% block script %}
<script src="/script/stock.js"></script>
{% endblock %}
