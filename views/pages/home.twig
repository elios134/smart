{% extends "layouts/base.twig" %}

{% block style %}
<link rel="stylesheet" href="/css/dashboard.css">
{% endblock %}

{% block header %}
    {% include "partials/_navbar.twig" %}
{% endblock %}

{% block main %}
<div class="main">

    {% if flash.success %}<div class="toast toast-success">✓ {{ flash.success }}</div>{% endif %}
    {% if flash.error %}<div class="toast toast-error">✕ {{ flash.error }}</div>{% endif %}

    <!-- KPIs -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-card__value">{{ kpis.produitsCount }}</div>
            <div class="stat-card__label">Produits</div>
        </div>
        <div class="stat-card">
            <div class="stat-card__value">{{ kpis.productionsEnCours }}</div>
            <div class="stat-card__label">Production en cours</div>
        </div>
        {% if userRole == 'SUPER_ADMIN' or userRole == 'ADMIN' %}
        <div class="stat-card">
            <div class="stat-card__value">{{ kpis.ventesAujourdhui }}</div>
            <div class="stat-card__label">Ventes aujourd'hui</div>
        </div>
        {% endif %}
    </div>

    <!-- Produits -->
    <div class="card">
        <div class="card__header">
            <span class="card__title">Produits</span>
            <a href="/produits" class="card__link">Gérer les produits →</a>
        </div>
        <table>
            <thead>
                <tr>
                    <th>Produit</th><th>Cout actuel</th><th>Seuil bas</th>
                    <th>Seuil haut</th><th>Stock</th><th>Statut</th>
                </tr>
            </thead>
            <tbody>
                {% for produit in produits %}
                <tr>
                    <td>{{ produit.nom }}</td>
                    <td>{{ produit.coutActuel }}</td>
                    <td>{{ produit.seuilBas }}</td>
                    <td>{{ produit.seuilHaut }}</td>
                    <td>{{ produit.stock.quantite ?? 0 }}</td>
                    <td>
                        {% if produit.statut == 'ACTIF' %}<span class="badge badge-green">{{ produit.statut }}</span>
                        {% elseif produit.statut == 'INACTIF' %}<span class="badge badge-red">{{ produit.statut }}</span>
                        {% else %}<span class="badge badge-blue">{{ produit.statut }}</span>{% endif %}
                    </td>
                </tr>
                {% else %}
                <tr><td colspan="6" class="empty-state">Aucun produit</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <!-- Employés — SUPER_ADMIN uniquement -->
    {% if userRole == 'SUPER_ADMIN' %}
    <div class="card">
        <div class="card__header">
            <span class="card__title">Employé</span>
            <button class="btn btn-primary" data-modal-open="modal-employe-add">Ajoutez</button>
        </div>
        <table>
            <thead>
                <tr><th>Nom</th><th>Prénom</th><th>Mail</th><th>Rôle</th><th>Actions</th></tr>
            </thead>
            <tbody>
                {% for employe in employes %}
                <tr>
                    <td>{{ employe.lastName }}</td>
                    <td>{{ employe.firstName }}</td>
                    <td>{{ employe.mail }}</td>
                    <td><span class="badge badge-muted">{{ employe.role }}</span></td>
                    <td style="display:flex;gap:8px;">
                        <button class="btn btn-outline"
                            data-modal-open="modal-employe-edit"
                            data-form="form-employe-edit"
                            data-action="/employes/{{ employe.id }}/edit"
                            data-fields='{"edit-emp-lastName":"{{ employe.lastName }}","edit-emp-firstName":"{{ employe.firstName }}","edit-emp-mail":"{{ employe.mail }}","edit-emp-role":"{{ employe.role }}"}'>
                            Modifié
                        </button>
                        <button class="btn btn-danger"
                            data-modal-open="modal-employe-delete"
                            data-form="form-employe-delete"
                            data-action="/employes/{{ employe.id }}/delete"
                            data-confirm-text="Supprimer {{ employe.firstName }} {{ employe.lastName }} ?"
                            data-confirm-target="delete-employe-text">
                            Supprimer
                        </button>
                    </td>
                </tr>
                {% else %}
                <tr><td colspan="5" class="empty-state">Aucun employé</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% endif %}
</div>
<!-- Modales Employés — SUPER_ADMIN uniquement -->
{% if userRole == 'SUPER_ADMIN' %}
<div id="modal-employe-add" class="modal-backdrop">
    <div class="modal">
        <h3 style="margin-bottom:24px;font-size:18px;font-weight:500;">Ajouter un employé</h3>
        <form method="POST" action="/employes/add">
            <div class="form-group"><label class="form-label">NOM :</label>
                <input type="text" name="lastName" class="form-input" placeholder="SWAG..." required></div>
            <div class="form-group"><label class="form-label">PRENOM :</label>
                <input type="text" name="firstName" class="form-input" placeholder="YOLO" required></div>
            <div class="form-group"><label class="form-label">MAIL :</label>
                <input type="mail" name="mail" class="form-input" placeholder="yolo@swag.fr" required></div>
            <div class="form-group"><label class="form-label">ROLES :</label>
                <select name="role" class="form-select">
                    <option value="OPERATEUR">Opérateur</option>
                    <option value="ADMIN">Admin</option>
                </select></div>
            <div class="form-group"><label class="form-label">MOT DE PASSE :</label>
                <div class="input-password-wrap">
                  <input type="password" name="password" class="form-input" required>
                  <button type="button" class="btn-toggle"><img src="/imgs/visibility-off.svg" alt="Afficher"></button>
                </div></div>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary btn-full">Ajoutez</button>
                <button type="button" class="btn btn-ghost btn-full" data-modal-close="modal-employe-add">Annulez</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Édition Employé -->
<div id="modal-employe-edit" class="modal-backdrop">
    <div class="modal">
        <h3 style="margin-bottom:24px;font-size:18px;font-weight:500;">Modifier l'employé</h3>
        <form id="form-employe-edit" method="POST" action="">
            <div class="form-group"><label class="form-label">NOM :</label>
                <input type="text" id="edit-emp-lastName" name="lastName" class="form-input" required></div>
            <div class="form-group"><label class="form-label">PRENOM :</label>
                <input type="text" id="edit-emp-firstName" name="firstName" class="form-input" required></div>
            <div class="form-group"><label class="form-label">MAIL :</label>
                <input type="email" id="edit-emp-mail" name="mail" class="form-input" required></div>
            <div class="form-group"><label class="form-label">ROLES :</label>
                <select id="edit-emp-role" name="role" class="form-select">
                    <option value="OPERATEUR">Opérateur</option>
                    <option value="ADMIN">Admin</option>
                </select></div>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary btn-full">Modifié</button>
                <button type="button" class="btn btn-ghost btn-full" data-modal-close="modal-employe-edit">Annulez</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Suppression Employé -->
<div id="modal-employe-delete" class="modal-backdrop">
    <div class="modal">
        <h3 style="margin-bottom:16px;font-size:18px;font-weight:500;">Supprimer l'employé</h3>
        <p id="delete-employe-text" style="color:var(--muted);margin-bottom:24px;"></p>
        <form id="form-employe-delete" method="POST" action="">
            <div class="form-actions">
                <button type="submit" class="btn btn-danger btn-full">Supprimer</button>
                <button type="button" class="btn btn-ghost btn-full" data-modal-close="modal-employe-delete">Annulez</button>
            </div>
        </form>
    </div>
</div>
{% endif %}
{% endblock %}
