{% extends "layouts/base.twig" %}

{% block style %}
<link rel="stylesheet" href="/css/dashboard.css">
{% endblock %}

{% block header %}
    {% include "partials/_navbar.twig" %}
{% endblock %}

{% block main %}
<div class="main">

    {% if flash.success %}<div class="toast toast-success">✓ {{ flash.success }}</div>{% endif %}
    {% if flash.error %}<div class="toast toast-error">✕ {{ flash.error }}</div>{% endif %}

    <!-- KPIs -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-card__value">{{ kpis.mwhProduits }}</div>
            <div class="stat-card__label">MWh produits aujourd'hui</div>
        </div>
        <div class="stat-card">
            <div class="stat-card__value">{{ kpis.mwhStockes }}</div>
            <div class="stat-card__label">MWh stockés</div>
        </div>
        {% if userRole == 'SUPER_ADMIN' or userRole == 'ADMIN' %}
        <div class="stat-card">
            <div class="stat-card__value">{{ kpis.caAujourdhui }} €</div>
            <div class="stat-card__label">CA ventes aujourd'hui</div>
        </div>
        {% endif %}
    </div>

    <!-- Sources actives -->
    <div class="card">
        <div class="card__header">
            <span class="card__title">Sources d'énergie</span>
            <a href="/energie" class="card__link">Gérer →</a>
        </div>
        <table>
            <thead>
                <tr>
                    <th>Source</th><th>Type</th><th>Stock (MWh)</th>
                    <th>Coût prod.</th><th>Statut</th>
                </tr>
            </thead>
            <tbody>
                {% for s in sources %}
                <tr>
                    <td>{{ s.nom }}</td>
                    <td><span class="badge badge-blue">{{ s.type }}</span></td>
                    <td>{{ s.stock.quantite ?? 0 }}</td>
                    <td>{{ s.coutProduction }} €/MWh</td>
                    <td>
                        {% if s.actif %}<span class="badge badge-green">ACTIF</span>
                        {% else %}<span class="badge badge-muted">INACTIF</span>{% endif %}
                    </td>
                </tr>
                {% else %}
                <tr><td colspan="5" class="empty-state">Aucune source — <a href="/energie" class="card__link">En configurer une →</a></td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <!-- Sessions en cours + Alertes -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-card__value">{{ kpis.sessionsEnCours }}</div>
            <div class="stat-card__label">Sessions en cours — <a href="/planification" class="card__link">Planifier →</a></div>
        </div>
        <div class="stat-card">
            <div class="stat-card__value">{{ alertes|length }}</div>
            <div class="stat-card__label">Seuils actifs — <a href="/energie" class="card__link">Configurer →</a></div>
        </div>
    </div>

    {% if userRole == 'SUPER_ADMIN' %}
    <!-- Employés -->
    <div class="card">
        <div class="card__header">
            <span class="card__title">Employés</span>
            <button class="btn btn-primary" data-modal-open="modal-employe-add">Ajouter</button>
        </div>
        <table>
            <thead>
                <tr><th>Nom</th><th>Prénom</th><th>Rôle</th><th>Actions</th></tr>
            </thead>
            <tbody>
                {% for e in employes %}
                <tr>
                    <td>{{ e.lastName }}</td>
                    <td>{{ e.firstName }}</td>
                    <td><span class="badge badge-blue">{{ e.role }}</span></td>
                    <td>
                        <button class="btn btn-outline"
                            data-modal-open="modal-employe-edit"
                            data-form="form-employe-edit"
                            data-action="/employes/{{ e.id }}/edit"
                            data-fields='{"edit-emp-firstName":"{{ e.firstName }}","edit-emp-lastName":"{{ e.lastName }}","edit-emp-mail":"{{ e.mail }}","edit-emp-role":"{{ e.role }}"}'>
                            Modifier
                        </button>
                        <button class="btn btn-danger"
                            data-modal-open="modal-employe-delete"
                            data-form="form-employe-delete"
                            data-action="/employes/{{ e.id }}/delete"
                            data-confirm-text="Supprimer {{ e.firstName }} {{ e.lastName }} ?"
                            data-confirm-target="delete-employe-text">
                            Supprimer
                        </button>
                    </td>
                </tr>
                {% else %}
                <tr><td colspan="4" class="empty-state">Aucun employé</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <div id="modal-employe-add" class="modal-backdrop">
        <div class="modal">
            <h3 class="modal__title">Ajouter un employé</h3>
            <form method="POST" action="/employes/add">
                <div class="form-group"><label class="form-label">Prénom *</label><input class="form-input" type="text" name="firstName" required></div>
                <div class="form-group"><label class="form-label">Nom *</label><input class="form-input" type="text" name="lastName" required></div>
                <div class="form-group"><label class="form-label">Email *</label><input class="form-input" type="email" name="mail" required></div>
                <div class="form-group"><label class="form-label">Rôle *</label>
                    <select class="form-select" name="role" required>
                        <option value="ADMIN">Admin</option>
                        <option value="OPERATEUR">Opérateur</option>
                    </select>
                </div>
                <div class="form-group"><label class="form-label">Mot de passe *</label><input class="form-input" type="password" name="password" required></div>
                <div class="form-actions">
                    <button type="submit" class="btn btn-primary btn-full">Ajouter</button>
                    <button type="button" class="btn btn-ghost btn-full" data-modal-close="modal-employe-add">Annuler</button>
                </div>
            </form>
        </div>
    </div>

    <div id="modal-employe-edit" class="modal-backdrop">
        <div class="modal">
            <h3 class="modal__title">Modifier l'employé</h3>
            <form id="form-employe-edit" method="POST" action="">
                <div class="form-group"><label class="form-label">Prénom *</label><input class="form-input" type="text" id="edit-emp-firstName" name="firstName" required></div>
                <div class="form-group"><label class="form-label">Nom *</label><input class="form-input" type="text" id="edit-emp-lastName" name="lastName" required></div>
                <div class="form-group"><label class="form-label">Email *</label><input class="form-input" type="email" id="edit-emp-mail" name="mail" required></div>
                <div class="form-group"><label class="form-label">Rôle *</label>
                    <select class="form-select" id="edit-emp-role" name="role">
                        <option value="ADMIN">Admin</option>
                        <option value="OPERATEUR">Opérateur</option>
                    </select>
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn btn-primary btn-full">Modifier</button>
                    <button type="button" class="btn btn-ghost btn-full" data-modal-close="modal-employe-edit">Annuler</button>
                </div>
            </form>
        </div>
    </div>

    <div id="modal-employe-delete" class="modal-backdrop">
        <div class="modal">
            <h3 class="modal__title">Supprimer l'employé</h3>
            <p id="delete-employe-text" class="modal__confirm-text"></p>
            <form id="form-employe-delete" method="POST" action="">
                <div class="form-actions">
                    <button type="submit" class="btn btn-danger btn-full">Supprimer</button>
                    <button type="button" class="btn btn-ghost btn-full" data-modal-close="modal-employe-delete">Annuler</button>
                </div>
            </form>
        </div>
    </div>
    {% endif %}

</div>
{% endblock %}
