{% extends 'layouts/base.twig' %}

{% block style %}
<style>
  /* Colonne unique centrée — fidèle maquette */
  .profil-grid { display:flex; flex-direction:column; gap:24px; max-width:520px; margin-inline:auto; }
  .profil-identity { display:flex; align-items:center; gap:16px; margin-bottom:24px; }
  .profil-avatar {
    width:56px; height:56px; border-radius:50%;
    background:var(--blue-dim); border:1px solid var(--blue-bd);
    display:flex; align-items:center; justify-content:center;
    font-size:20px; font-weight:700; color:var(--text-link);
    text-transform:uppercase; flex-shrink:0;
  }
  .profil-identity__name { font-size:18px; font-weight:600; color:var(--text); }
  .profil-identity__role { margin-top:6px; }
</style>
{% endblock %}

{% block header %}
{% include 'partials/_navbar.twig' with { activePage: '', user: user } %}
{% endblock %}

{% block main %}
<div class="main">

  {% if flash.success %}
  <div class="toast-container">
    <div class="toast toast-success">✓ {{ flash.success }}</div>
  </div>
  {% endif %}
  {% if flash.error %}
  <div class="toast-container">
    <div class="toast toast-error">✕ {{ flash.error }}</div>
  </div>
  {% endif %}

  <div class="profil-grid">

    {# Informations personnelles #}
    <div class="card">
      <div class="profil-identity">
        <div class="profil-avatar">{{ user.firstName|slice(0,1) }}{{ user.lastName|slice(0,1) }}</div>
        <div>
          <div class="profil-identity__name">{{ user.firstName ?? '' }} {{ user.lastName ?? '' }}</div>
          {% if user.role %}<div class="profil-identity__role"><span class="badge badge-blue">{{ user.role }}</span></div>{% endif %}
        </div>
      </div>
      <form method="POST" action="/profil">
        <div class="form-group">
          <label class="form-label">Prénom</label>
          <input class="form-input" type="text" name="firstName"
            value="{{ user.firstName ?? '' }}" required>
        </div>
        <div class="form-group">
          <label class="form-label">Nom</label>
          <input class="form-input" type="text" name="lastName"
            value="{{ user.lastName ?? '' }}" required>
        </div>
        <div class="form-group">
          <label class="form-label">Adresse mail</label>
          <input class="form-input" type="email" name="mail"
            value="{{ user.mail ?? '' }}" required>
        </div>
        <div class="form-group">
          <label class="form-label">Raison sociale</label>
          <input class="form-input" type="text" name="socialReason"
            value="{{ user.socialReason ?? '' }}">
        </div>
        <div class="form-group">
          <label class="form-label">SIRET</label>
          <input class="form-input" type="text" name="siret"
            value="{{ user.siret ?? '' }}" readonly
            style="opacity:.6; cursor:not-allowed;">
        </div>
        <button type="submit" class="btn btn-primary" style="margin-top:8px;">Sauvegarder</button>
      </form>
    </div>

    {# Changement de mot de passe #}
    <div class="card">
      <div class="card__header">
        <span class="card__title">Mot de passe</span>
      </div>
      <form method="POST" action="/reset-password">
        <div class="form-group">
          <label class="form-label">Mot de passe actuel</label>
          <div class="input-password-wrap">
            <input class="form-input" type="password" name="currentPassword"
              placeholder="••••••••" required>
            <button type="button" class="btn-toggle"><img src="/imgs/visibility-off.svg" alt="Afficher"></button>
          </div>
        </div>
        <div class="form-group">
          <label class="form-label">Nouveau mot de passe</label>
          <div class="input-password-wrap">
            <input class="form-input" type="password" name="newPassword"
              placeholder="Min. 8 caractères" required>
            <button type="button" class="btn-toggle"><img src="/imgs/visibility-off.svg" alt="Afficher"></button>
          </div>
        </div>
        <div class="form-group">
          <label class="form-label">Confirmer</label>
          <div class="input-password-wrap">
            <input class="form-input" type="password" name="confirmPassword"
              placeholder="••••••••" required>
            <button type="button" class="btn-toggle"><img src="/imgs/visibility-off.svg" alt="Afficher"></button>
          </div>
        </div>
        <button type="submit" class="btn btn-outline" style="margin-top:8px;">Changer le mot de passe</button>
      </form>
    </div>

  </div>
</div>
{% endblock %}
