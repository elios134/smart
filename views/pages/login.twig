{% extends 'layouts/base.twig' %}

{% block style %}
<link rel="stylesheet" href="/css/login.css">
{% endblock %}

{% block main %}
<div class="login-page">
  <div class="login-card">
    <h1 class="login-card__title">Connexion</h1>

    {% if flash.success %}
    <div class="toast toast-success" style="margin-bottom:20px;">✓ Mot de passe réinitialisé — connectez-vous</div>
    {% endif %}

    {% if error is defined and error %}
    <div class="toast toast-error" style="margin-bottom:20px;">✕ {{ error }}</div>
    {% endif %}

    <form method="POST" action="/login">
      <div class="form-group">
        <label class="form-label">Mail</label>
        <input class="form-input" type="email" name="email" placeholder="Adresse Mail..." required autofocus>
      </div>
      <div class="form-group">
        <label class="form-label">Mot de passe</label>
        <input class="form-input" type="password" name="password" placeholder="Mot de passe..." required>
      </div>
      <button type="submit" class="btn btn-primary btn-full" style="margin-top:8px;">Se connecter</button>
    </form>

    <div class="login-card__links">
      <a href="/employes/login">Espace employé</a>
      <a href="/forgot-password">Pwd oublié</a>
    </div>
  </div>
</div>
{% endblock %}


