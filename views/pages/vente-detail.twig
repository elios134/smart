{% extends "layouts/base.twig" %}

{% block style %}
<link rel="stylesheet" href="/css/ventes.css">
{% endblock %}

{% block header %}
    {% include "partials/_navbar.twig" %}
{% endblock %}

{% block main %}
<div class="main">

    {% if flash.success %}<div class="toast toast-success">✓ {{ flash.success }}</div>{% endif %}
    {% if flash.error %}<div class="toast toast-error">✕ {{ flash.error }}</div>{% endif %}

    <div class="detail-header">
        <a href="/ventes" class="section-label">← Retour aux ventes</a>
        {% if userRole == 'SUPER_ADMIN' %}
        <button class="btn btn-danger"
            data-modal-open="modal-vente-delete"
            data-form="form-vente-delete"
            data-action="/ventes/{{ vente.id }}/delete"
            data-confirm-text="Supprimer cette vente de {{ vente.quantite }} MWh ? Le stock sera restauré."
            data-confirm-target="delete-vente-text">
            Supprimer la vente
        </button>
        {% endif %}
    </div>

    <div class="detail-grid">
        <!-- Détails de la vente -->
        <div class="card">
            <div class="card__header">
                <span class="card__title">Détails de la vente</span>
            </div>
            <div class="detail-row">
                <span class="detail-row__label">Référence</span>
                <span class="detail-row__value">#{{ vente.id }}</span>
            </div>
            <div class="detail-row">
                <span class="detail-row__label">Date</span>
                <span class="detail-row__value">{{ vente.createdAt|date('d/m/Y H:i') }}</span>
            </div>
            <div class="detail-row">
                <span class="detail-row__label">Source</span>
                <span class="detail-row__value">
                    <span class="badge badge-blue">{{ vente.source.type }}</span>
                    {{ vente.source.nom }}
                </span>
            </div>
            <div class="detail-row">
                <span class="detail-row__label">Client</span>
                <span class="detail-row__value">{{ vente.tiers ? vente.tiers.nom : '—' }}</span>
            </div>
        </div>

        <!-- Informations source -->
        <div class="card">
            <div class="card__header">
                <span class="card__title">Source d'énergie</span>
            </div>
            <div class="detail-row">
                <span class="detail-row__label">Nom</span>
                <span class="detail-row__value">{{ vente.source.nom }}</span>
            </div>
            <div class="detail-row">
                <span class="detail-row__label">Type</span>
                <span class="detail-row__value"><span class="badge badge-blue">{{ vente.source.type }}</span></span>
            </div>
            <div class="detail-row">
                <span class="detail-row__label">Coût de prod.</span>
                <span class="detail-row__value">{{ vente.source.coutProduction }} €/MWh</span>
            </div>
        </div>
    </div>

    <!-- Détail financier -->
    <div class="card">
        <div class="card__header">
            <span class="card__title">Détail financier</span>
        </div>
        <table class="table--sm-hide-3">
            <thead>
                <tr>
                    <th>Désignation</th><th>Quantité</th><th>Prix unitaire</th><th>Total</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Énergie — {{ vente.source.nom }} ({{ vente.source.type }})</td>
                    <td>{{ vente.quantite }} MWh</td>
                    <td>{{ vente.prixVente }} €/MWh</td>
                    <td><strong>{{ vente.total }} €</strong></td>
                </tr>
            </tbody>
        </table>

        <div class="facture-totaux">
            <div class="facture-ligne">
                <span class="facture-ligne__label">Coût de production</span>
                <span class="facture-ligne__value">{{ (vente.quantite * vente.source.coutProduction)|round(2) }} €</span>
            </div>
            <div class="facture-ligne">
                <span class="facture-ligne__label">Prix de vente</span>
                <span class="facture-ligne__value">{{ vente.prixVente }} €/MWh</span>
            </div>
            <div class="facture-ligne facture-ligne--ttc">
                <span class="facture-ligne__label">Total encaissé</span>
                <span class="facture-ligne__value">{{ vente.total }} €</span>
            </div>
        </div>
    </div>

</div>

{% if userRole == 'SUPER_ADMIN' %}
<div id="modal-vente-delete" class="modal-backdrop">
    <div class="modal">
        <h3 class="modal__title">Supprimer la vente</h3>
        <p id="delete-vente-text" class="modal__confirm-text"></p>
        <form id="form-vente-delete" method="POST" action="">
            <div class="form-actions">
                <button type="submit" class="btn btn-danger btn-full">Supprimer</button>
                <button type="button" class="btn btn-ghost btn-full" data-modal-close="modal-vente-delete">Annuler</button>
            </div>
        </form>
    </div>
</div>
{% endif %}

{% endblock %}
