{% extends "layouts/base.twig" %}

{% block style %}
<link rel="stylesheet" href="/css/dashboard.css">
<link rel="stylesheet" href="/css/ventes.css">
{% endblock %}

{% block header %}
    {% include "partials/_navbar.twig" %}
{% endblock %}

{% block main %}
<div class="main">

    {% if flash.success %}<div class="toast toast-success">✓ {{ flash.success }}</div>{% endif %}
    {% if flash.error %}<div class="toast toast-error">✕ {{ flash.error }}</div>{% endif %}

    <!-- KPIs -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-card__value">{{ kpis.chiffreAffaires }} €</div>
            <div class="stat-card__label">Chiffre d'affaires</div>
        </div>
        <div class="stat-card">
            <div class="stat-card__value">{{ kpis.nbVentes }}</div>
            <div class="stat-card__label">Nombre de ventes</div>
        </div>
        <div class="stat-card">
            <div class="stat-card__value">{{ kpis.panierMoyen }} €</div>
            <div class="stat-card__label">Panier moyen</div>
        </div>
        <div class="stat-card">
            <div class="stat-card__value">{{ kpis.volumeVendu }}</div>
            <div class="stat-card__label">MWh vendus</div>
        </div>
        <div class="stat-card">
            <div class="stat-card__value">{{ kpis.margeNette }} €</div>
            <div class="stat-card__label">Marge nette</div>
        </div>
    </div>

    <!-- Historique -->
    <div class="card">
        <div class="card__header">
            <span class="card__title">Historique des ventes</span>
            <button class="btn btn-primary" data-modal-open="modal-vente-add"><i class="ti ti-plus"></i> Nouvelle vente</button>
        </div>
        <table class="table--sm-hide-2-4-6">
            <thead>
                <tr>
                    <th>Source</th><th>Client</th><th>Quantité (MWh)</th>
                    <th>Prix (€/MWh)</th><th>Total (€)</th><th>Date</th><th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for v in ventes %}
                <tr>
                    <td>{{ v.source.nom }}</td>
                    <td>{{ v.tiers ? v.tiers.nom : '—' }}</td>
                    <td>{{ v.quantite }} MWh</td>
                    <td>{{ v.prixVente }} €</td>
                    <td><strong>{{ v.total }} €</strong></td>
                    <td>{{ v.createdAt|date('d/m/Y') }}</td>
                    <td>
                        <a href="/ventes/{{ v.id }}" class="btn btn-outline">Détails</a>
                        {% if userRole == 'SUPER_ADMIN' %}
                        <button class="btn btn-danger"
                            data-modal-open="modal-vente-delete"
                            data-form="form-vente-delete"
                            data-action="/ventes/{{ v.id }}/delete"
                            data-confirm-text="Supprimer cette vente de {{ v.quantite }} MWh ?"
                            data-confirm-target="delete-vente-text">
                            Supprimer
                        </button>
                        {% endif %}
                    </td>
                </tr>
                {% else %}
                <tr><td colspan="7" class="empty-state">Aucune vente enregistrée</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Nouvelle vente -->
<div id="modal-vente-add" class="modal-backdrop">
    <div class="modal">
        <h3 class="modal__title">Nouvelle vente d'énergie</h3>
        <form method="POST" action="/ventes/add">
            <div class="form-group">
                <label class="form-label">Source *</label>
                <select class="form-select" name="sourceId" required>
                    <option value="">Sélectionner...</option>
                    {% for s in sources %}
                    <option value="{{ s.id }}" data-prix="{{ s.coutProduction }}">
                        {{ s.nom }} — stock : {{ s.stock.quantite ?? 0 }} MWh
                    </option>
                    {% endfor %}
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">Client</label>
                <select class="form-select" name="tiersId">
                    <option value="">Aucun</option>
                    {% for c in clients %}
                    <option value="{{ c.id }}">{{ c.nom }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">Quantité (MWh) *</label>
                <input class="form-input" type="number" step="0.01" min="0"id="vente-quantite" name="quantite" placeholder="50" required>
            </div>
            <div class="form-group">
                <label class="form-label">Prix de vente (€/MWh) *</label>
                <input class="form-input" type="number" step="0.01" min="0"id="vente-prix" name="prixVente" placeholder="80" required>
            </div>
            <div class="total-estime">
                <span>Total estimé</span>
                <span class="total-estime__value" id="vente-total-estime">0 €</span>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary btn-full">Valider la vente</button>
                <button type="button" class="btn btn-ghost btn-full" data-modal-close="modal-vente-add">Annuler</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Suppression -->
<div id="modal-vente-delete" class="modal-backdrop">
    <div class="modal">
        <h3 class="modal__title">Supprimer la vente</h3>
        <p id="delete-vente-text" class="modal__confirm-text"></p>
        <form id="form-vente-delete" method="POST" action="">
            <div class="form-actions">
                <button type="submit" class="btn btn-danger btn-full">Supprimer</button>
                <button type="button" class="btn btn-ghost btn-full" data-modal-close="modal-vente-delete">Annuler</button>
            </div>
        </form>
    </div>
</div>

{% endblock %}

{% block script %}
<script src="/script/ventes.js"></script>
{% endblock %}
