{% extends 'layouts/base.twig' %}

{% block style %}
<link rel="stylesheet" href="/css/login.css">
<style>
  .login-card { max-width: 480px; }
  .setup-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
</style>
{% endblock %}

{% block main %}
<div class="login-page">
  <div class="login-card">
    <h1 class="login-card__title">Création du compte</h1>

    {% if error %}
    <div class="toast toast-error" style="margin-bottom:20px;">✕ {{ error }}</div>
    {% endif %}

    {% if token %}
    <form method="POST" action="/setup/{{ token }}">
      <div class="setup-grid">
        <div class="form-group">
          <label class="form-label">PRÉNOM *</label>
          <input class="form-input" type="text" name="firstName" placeholder="Jean" required>
        </div>
        <div class="form-group">
          <label class="form-label">NOM *</label>
          <input class="form-input" type="text" name="lastName" placeholder="Dupont" required>
        </div>
      </div>
      <div class="form-group">
        <label class="form-label">ADRESSE MAIL *</label>
        <input class="form-input" type="email" name="mail" placeholder="admin@entreprise.fr" required>
      </div>
      <div class="form-group">
        <label class="form-label">RAISON SOCIALE *</label>
        <input class="form-input" type="text" name="socialReason" placeholder="Mon Entreprise SAS" required>
      </div>
      <div class="setup-grid">
        <div class="form-group">
          <label class="form-label">SIRET *</label>
          <input class="form-input" type="text" name="siret" placeholder="123 456 789 00001" required>
        </div>
        <div class="form-group">
          <label class="form-label">NOM DU DIRIGEANT</label>
          <input class="form-input" type="text" name="directorName" placeholder="Jean Dupont">
        </div>
      </div>
      <div class="setup-grid">
        <div class="form-group">
          <label class="form-label">MOT DE PASSE *</label>
          <input class="form-input" type="password" name="password" placeholder="Min. 8 caractères" required minlength="8">
        </div>
        <div class="form-group">
          <label class="form-label">CONFIRMER *</label>
          <input class="form-input" type="password" name="confirmPassword" placeholder="••••••••" required minlength="8">
        </div>
      </div>
      <button type="submit" class="btn btn-primary btn-full" style="margin-top:12px;">Créer mon compte</button>
    </form>
    {% else %}
    <p style="color:var(--muted);text-align:center;padding:24px 0;">Ce lien est invalide ou a expiré.</p>
    <a href="/login" class="btn btn-outline btn-full" style="text-align:center;">Retour à la connexion</a>
    {% endif %}
  </div>
</div>
{% endblock %}
