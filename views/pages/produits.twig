{% extends "layouts/base.twig" %}

{% block header %}
    {% include "partials/_navbar.twig" %}
{% endblock %}

{% block main %}
<div class="main">

    {% if flash.success %}<div class="toast toast-success">✓ {{ flash.success }}</div>{% endif %}
    {% if flash.error %}<div class="toast toast-error">✕ {{ flash.error }}</div>{% endif %}

    <div class="card">
        <div class="card__header">
            <span class="card__title">Produits</span>
            <button class="btn btn-primary" data-modal-open="modal-produit-add">Ajoutez</button>
        </div>
        <table class="table--sm-hide-2-3-4">
            <thead>
                <tr>
                    <th>Produit</th><th>Cout actuel</th><th>Seuil bas</th>
                    <th>Seuil haut</th><th>Stock</th><th>Statut</th><th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for produit in produits %}
                <tr>
                    <td>{{ produit.nom }}</td>
                    <td>{{ produit.coutActuel }}</td>
                    <td>{{ produit.seuilBas }}</td>
                    <td>{{ produit.seuilHaut }}</td>
                    <td>{{ produit.stock.quantite ?? 0 }}</td>
                    <td>
                        {% if produit.statut == 'ACTIF' %}<span class="badge badge-green">{{ produit.statut }}</span>
                        {% elseif produit.statut == 'INACTIF' %}<span class="badge badge-red">{{ produit.statut }}</span>
                        {% else %}<span class="badge badge-blue">{{ produit.statut }}</span>{% endif %}
                    </td>
                    <td style="display:flex;gap:8px;">
                        {% if userRole == 'SUPER_ADMIN' or userRole == 'ADMIN' %}
                        <button class="btn btn-outline"
                            data-modal-open="modal-produit-edit"
                            data-form="form-produit-edit"
                            data-action="/produits/{{ produit.id }}/edit"
                            data-fields='{"edit-p-nom":"{{ produit.nom }}","edit-p-cout":"{{ produit.coutActuel }}","edit-p-seuilBas":"{{ produit.seuilBas }}","edit-p-seuilHaut":"{{ produit.seuilHaut }}","edit-p-stock":"{{ produit.stock.quantite ?? 0 }}","edit-p-prixVente":"{{ produit.prixVente }}","edit-p-statut":"{{ produit.statut }}"}'>
                            Modifié
                        </button>
                        <button class="btn btn-danger"
                            data-modal-open="modal-produit-delete"
                            data-form="form-produit-delete"
                            data-action="/produits/{{ produit.id }}/delete"
                            data-confirm-text="Supprimer {{ produit.nom }} ?"
                            data-confirm-target="delete-produit-text">
                            Supprimer
                        </button>
                        {% endif %}
                    </td>
                </tr>
                {% else %}
                <tr><td colspan="7" class="empty-state">Aucun produit</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Ajout -->
<div id="modal-produit-add" class="modal-backdrop">
    <div class="modal">
        <h3 style="margin-bottom:24px;font-size:18px;font-weight:500;">Ajouter un produit</h3>
        <form method="POST" action="/produits/add">
            <div class="form-group"><label class="form-label">NOM *</label>
                <input type="text" name="nom" class="form-input" placeholder="SWAG..." required></div>
            <div class="form-group"><label class="form-label">COUT ACTUEL *</label>
                <input type="number" step="0.01" name="coutActuel" class="form-input" placeholder="155" required></div>
            <div class="form-group"><label class="form-label">SEUIL BAS *</label>
                <input type="number" step="0.01" name="seuilBas" class="form-input" placeholder="154" required></div>
            <div class="form-group"><label class="form-label">SEUIL HAUT *</label>
                <input type="number" step="0.01" name="seuilHaut" class="form-input" placeholder="156" required></div>
            <div class="form-group"><label class="form-label">STOCK *</label>
                <input type="number" step="0.01" name="stock" class="form-input" placeholder="0" required></div>
            <div class="form-group"><label class="form-label">PRIX DE VENTE *</label>
                <input type="number" step="0.01" name="prixVente" class="form-input" placeholder="200" required></div>
            <div class="form-group"><label class="form-label">STATUTS *</label>
                <select name="statut" class="form-select">
                    <option value="EN_ATTENTE">En attente</option>
                    <option value="ACTIF">Actif</option>
                    <option value="INACTIF">Inactif</option>
                </select></div>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary btn-full">Ajoutez</button>
                <button type="button" class="btn btn-ghost btn-full" data-modal-close="modal-produit-add">Annulez</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Édition -->
<div id="modal-produit-edit" class="modal-backdrop">
    <div class="modal">
        <h3 style="margin-bottom:24px;font-size:18px;font-weight:500;">Modifier le produit</h3>
        <form id="form-produit-edit" method="POST" action="">
            <div class="form-group"><label class="form-label">NOM *</label>
                <input type="text" id="edit-p-nom" name="nom" class="form-input" required></div>
            <div class="form-group"><label class="form-label">COUT ACTUEL *</label>
                <input type="number" step="0.01" id="edit-p-cout" name="coutActuel" class="form-input" required></div>
            <div class="form-group"><label class="form-label">SEUIL BAS *</label>
                <input type="number" step="0.01" id="edit-p-seuilBas" name="seuilBas" class="form-input" required></div>
            <div class="form-group"><label class="form-label">SEUIL HAUT *</label>
                <input type="number" step="0.01" id="edit-p-seuilHaut" name="seuilHaut" class="form-input" required></div>
            <div class="form-group"><label class="form-label">STOCK *</label>
                <input type="number" step="0.01" id="edit-p-stock" name="stock" class="form-input" required></div>
            <div class="form-group"><label class="form-label">PRIX DE VENTE *</label>
                <input type="number" step="0.01" id="edit-p-prixVente" name="prixVente" class="form-input" required></div>
            <div class="form-group"><label class="form-label">STATUTS *</label>
                <select id="edit-p-statut" name="statut" class="form-select">
                    <option value="EN_ATTENTE">En attente</option>
                    <option value="ACTIF">Actif</option>
                    <option value="INACTIF">Inactif</option>
                </select></div>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary btn-full">Modifié</button>
                <button type="button" class="btn btn-ghost btn-full" data-modal-close="modal-produit-edit">Annulez</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Suppression -->
<div id="modal-produit-delete" class="modal-backdrop">
    <div class="modal">
        <h3 style="margin-bottom:16px;font-size:18px;font-weight:500;">Supprimer le produit</h3>
        <p id="delete-produit-text" style="color:var(--muted);margin-bottom:24px;"></p>
        <form id="form-produit-delete" method="POST" action="">
            <div class="form-actions">
                <button type="submit" class="btn btn-danger btn-full">Supprimer</button>
                <button type="button" class="btn btn-ghost btn-full" data-modal-close="modal-produit-delete">Annulez</button>
            </div>
        </form>
    </div>
</div>
{% endblock %}
