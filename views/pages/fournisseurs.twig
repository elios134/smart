{% extends "layouts/base.twig" %}

{% block header %}
    {% include "partials/_navbar.twig" %}
{% endblock %}

{% block main %}
<div class="main">

    {% if flash.success %}<div class="toast toast-success">✓ {{ flash.success }}</div>{% endif %}
    {% if flash.error %}<div class="toast toast-error">✕ {{ flash.error }}</div>{% endif %}

    <div class="card">
        <div class="card__header">
            <span class="card__title">Gestion des Fournisseurs & Clients</span>
            {% if userRole == 'SUPER_ADMIN' or userRole == 'ADMIN' %}
            <button class="btn btn-primary" data-modal-open="modal-fournisseur-add">Ajouter</button>
            {% endif %}
        </div>
        <table class="table--sm-hide-3-4-5-6">
            <thead>
                <tr>
                    <th>Nom</th><th>Type</th><th>Contact</th><th>Mail</th><th>Téléphone</th>
                    <th>Délai (j)</th>{% if userRole == 'SUPER_ADMIN' or userRole == 'ADMIN' %}<th>Actions</th>{% endif %}
                </tr>
            </thead>
            <tbody>
                {% for f in fournisseurs %}
                <tr>
                    <td>{{ f.nom }}</td>
                    <td>
                        {% if f.typeTiers == 'CLIENT' %}
                            <span class="badge badge-green">CLIENT</span>
                        {% else %}
                            <span class="badge badge-blue">FOURNISSEUR</span>
                        {% endif %}
                    </td>
                    <td>{{ f.nomContact ?? '—' }}</td>
                    <td>{{ f.mail ?? '—' }}</td>
                    <td>{{ f.telephone ?? '—' }}</td>
                    <td>{{ f.delaiLivraison ?? '—' }}</td>
                    {% if userRole == 'SUPER_ADMIN' or userRole == 'ADMIN' %}
                    <td>
                        <button class="btn btn-outline"
                            data-modal-open="modal-fournisseur-edit"
                            data-form="form-fournisseur-edit"
                            data-action="/fournisseurs/{{ f.id }}/edit"
                            data-fields='{"edit-f-nom":"{{ f.nom }}","edit-f-contact":"{{ f.nomContact ?? "" }}","edit-f-fonction":"{{ f.fonctionContact ?? "" }}","edit-f-mail":"{{ f.mail ?? "" }}","edit-f-tel":"{{ f.telephone ?? "" }}","edit-f-delai":"{{ f.delaiLivraison ?? "" }}","edit-f-notes":"{{ f.notes ?? "" }}"}'>
                            Modifier
                        </button>
                        {% if userRole == 'SUPER_ADMIN' %}
                        <button class="btn btn-danger"
                            data-modal-open="modal-fournisseur-delete"
                            data-form="form-fournisseur-delete"
                            data-action="/fournisseurs/{{ f.id }}/delete"
                            data-confirm-text="Supprimer {{ f.nom }} ?"
                            data-confirm-target="delete-fournisseur-text">
                            Supprimer
                        </button>
                        {% endif %}
                    </td>
                    {% endif %}
                </tr>
                {% else %}
                <tr><td colspan="7" class="empty-state">Aucun fournisseur ou client enregistré</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

{% if userRole == 'SUPER_ADMIN' or userRole == 'ADMIN' %}
<div id="modal-fournisseur-add" class="modal-backdrop">
    <div class="modal">
        <h3 class="modal__title">Ajouter un fournisseur / client</h3>
        <form method="POST" action="/fournisseurs/add">
            <div class="form-group"><label class="form-label">Nom *</label><input class="form-input" type="text" name="nom" required></div>
            <div class="form-group"><label class="form-label">Type *</label>
                <select class="form-select" name="typeTiers" required>
                    <option value="FOURNISSEUR">Fournisseur d'énergie</option>
                    <option value="CLIENT">Client acheteur</option>
                </select>
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
                <div class="form-group"><label class="form-label">Nom du contact</label><input class="form-input" type="text" name="nomContact"></div>
                <div class="form-group"><label class="form-label">Fonction</label><input class="form-input" type="text" name="fonctionContact"></div>
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
                <div class="form-group"><label class="form-label">Email</label><input class="form-input" type="email" name="mail"></div>
                <div class="form-group"><label class="form-label">Téléphone</label><input class="form-input" type="text" name="telephone"></div>
            </div>
            <div class="form-group"><label class="form-label">Délai de livraison (jours)</label><input class="form-input" type="number" min="0" name="delaiLivraison" placeholder="5"></div>
            <div class="form-group"><label class="form-label">Notes</label><textarea class="form-input" name="notes" rows="3"></textarea></div>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary btn-full">Ajouter</button>
                <button type="button" class="btn btn-ghost btn-full" data-modal-close="modal-fournisseur-add">Annuler</button>
            </div>
        </form>
    </div>
</div>

<div id="modal-fournisseur-edit" class="modal-backdrop">
    <div class="modal">
        <h3 class="modal__title">Modifier</h3>
        <form id="form-fournisseur-edit" method="POST" action="">
            <div class="form-group"><label class="form-label">Nom *</label><input class="form-input" type="text" id="edit-f-nom" name="nom" required></div>
            <div class="form-group"><label class="form-label">Type *</label>
                <select class="form-select" name="typeTiers" required>
                    <option value="FOURNISSEUR">Fournisseur d'énergie</option>
                    <option value="CLIENT">Client acheteur</option>
                </select>
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
                <div class="form-group"><label class="form-label">Nom du contact</label><input class="form-input" type="text" id="edit-f-contact" name="nomContact"></div>
                <div class="form-group"><label class="form-label">Fonction</label><input class="form-input" type="text" id="edit-f-fonction" name="fonctionContact"></div>
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
                <div class="form-group"><label class="form-label">Email</label><input class="form-input" type="email" id="edit-f-mail" name="mail"></div>
                <div class="form-group"><label class="form-label">Téléphone</label><input class="form-input" type="text" id="edit-f-tel" name="telephone"></div>
            </div>
            <div class="form-group"><label class="form-label">Délai de livraison (jours)</label><input class="form-input" type="number" id="edit-f-delai" name="delaiLivraison"></div>
            <div class="form-group"><label class="form-label">Notes</label><textarea class="form-input" id="edit-f-notes" name="notes" rows="3"></textarea></div>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary btn-full">Modifier</button>
                <button type="button" class="btn btn-ghost btn-full" data-modal-close="modal-fournisseur-edit">Annuler</button>
            </div>
        </form>
    </div>
</div>

<div id="modal-fournisseur-delete" class="modal-backdrop">
    <div class="modal">
        <h3 class="modal__title">Supprimer le fournisseur</h3>
        <p id="delete-fournisseur-text" class="modal__confirm-text"></p>
        <form id="form-fournisseur-delete" method="POST" action="">
            <div class="form-actions">
                <button type="submit" class="btn btn-danger btn-full">Supprimer</button>
                <button type="button" class="btn btn-ghost btn-full" data-modal-close="modal-fournisseur-delete">Annuler</button>
            </div>
        </form>
    </div>
</div>
{% endif %}
{% endblock %}
