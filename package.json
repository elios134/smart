{
  "name": "Smart-Yield",
  "version": "1.0.0",
  "description": "Application gestion entreprise ",
  "author": "André-Bribanick",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "server": "node server.js",
    "dev": "electron . --inspect",
    "dev:server": "nodemon server.js",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "db:seed": "node prisma/seed.js",
    "test:seed": "node tests/seed-test.js",
    "test:run": "node --test tests/run-tests.js",
    "test:clean": "node tests/cleanup-test.js",
    "test": "node tests/seed-test.js && node --test tests/run-tests.js && node tests/cleanup-test.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "7.4.1",
    "@prisma/client": "7.4.1",
    "bcryptjs": "3.0.3",
    "dotenv": "^17.3.1",
    "express": "5.2.1",
    "express-session": "1.19.0",
    "nodemailer": "8.0.1",
    "prisma": "7.4.1",
    "twig": "1.17.1"
  },
  "devDependencies": {
    "electron": "^40.6.0",
    "electron-builder": "^26.8.1",
    "supertest": "^7.1.0"
  },
  "build": {
    "appId": "com.tonentreprise.rh",
    "productName": "Smart-Yield",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "views/**/*",
      "public/**/*",
      "prisma/**/*",
      ".env"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "public/icon.icns"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
