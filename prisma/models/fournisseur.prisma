model Fournisseur {
  id              Int      @id @default(autoincrement())
  nom             String
  nomContact      String
  fonctionContact String?
  email           String
  telephone       String
  delaiLivraison  Int      @default(0) // en jours ouvrés
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  achats          AchatMP[]
  matieres        FournisseurMatiere[]

  @@map("fournisseurs")
}

model FournisseurMatiere {
  id             Int      @id @default(autoincrement())

  fournisseur    Fournisseur     @relation(fields: [fournisseurId], references: [id], onDelete: Cascade)
  fournisseurId  Int

  matiere        MatierePremiere @relation(fields: [matiereId], references: [id], onDelete: Cascade)
  matiereId      Int

  @@unique([fournisseurId, matiereId])
  @@map("fournisseur_matieres")
}

model AchatMP {
  id              Int      @id @default(autoincrement())
  quantite        Float
  prixUnitaire    Float
  total           Float
  statut          StatutAchat @default(EN_ATTENTE)
  dateLivraison   DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  matiere         MatierePremiere @relation(fields: [matiereId], references: [id])
  matiereId       Int

  fournisseur     Fournisseur @relation(fields: [fournisseurId], references: [id])
  fournisseurId   Int

  @@map("achats_mp")
}

enum StatutAchat {
  EN_ATTENTE
  LIVRE
  ANNULE
}
