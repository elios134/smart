model SourceEnergie {
  id             Int        @id @default(autoincrement())
  nom            String
  type           TypeSource
  coutProduction Float      @default(0)
  couleur        String     @default("#4F8AFF")
  actif          Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  stock          StockEnergie?
  sessions       SessionEnergie[]
  achats         AchatEnergie[]
  ventes         VenteEnergie[]
  seuil          SeuilEnergie?

  @@map("sources_energie")
}

enum TypeSource {
  EOLIEN
  SOLAIRE
  HYDRAULIQUE
  HYDROGENE
  RESEAU
}

model StockEnergie {
  id        Int      @id @default(autoincrement())
  quantite  Float    @default(0)
  updatedAt DateTime @updatedAt

  source    SourceEnergie @relation(fields: [sourceId], references: [id])
  sourceId  Int           @unique

  @@map("stocks_energie")
}

model AchatEnergie {
  id        Int      @id @default(autoincrement())
  quantite  Float
  prixAchat Float
  total     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  source    SourceEnergie @relation(fields: [sourceId], references: [id])
  sourceId  Int

  tiers     Tiers?   @relation(fields: [tiersId], references: [id])
  tiersId   Int?

  @@map("achats_energie")
}

model VenteEnergie {
  id        Int      @id @default(autoincrement())
  quantite  Float
  prixVente Float
  total     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  source    SourceEnergie @relation(fields: [sourceId], references: [id])
  sourceId  Int

  tiers     Tiers?   @relation(fields: [tiersId], references: [id])
  tiersId   Int?

  @@map("ventes_energie")
}

model SeuilEnergie {
  id                 Int         @id @default(autoincrement())
  seuilDeclenchement Float       @default(20)
  seuilArret         Float       @default(10)
  declenchementAuto  Boolean     @default(false)
  statut             StatutActif @default(ACTIF)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  source             SourceEnergie @relation(fields: [sourceId], references: [id])
  sourceId           Int           @unique

  @@map("seuils_energie")
}

enum StatutActif {
  ACTIF
  INACTIF
}
