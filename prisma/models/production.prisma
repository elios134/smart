model Production {
  id          Int      @id @default(autoincrement())
  quantite    Float
  coutFab     Float    @default(0)
  debutFab    DateTime
  finFab      DateTime
  statut      StatutProduction @default(EN_ATTENTE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  produit     Produit  @relation(fields: [produitId], references: [id])
  produitId   Int

  machine     Machine? @relation(fields: [machineId], references: [id])
  machineId   Int?

  consommations ConsommationMP[]

  @@map("productions")
}

model Nomenclature {
  id          Int      @id @default(autoincrement())
  quantite    Float

  produit     Produit         @relation(fields: [produitId], references: [id])
  produitId   Int

  matiere     MatierePremiere @relation(fields: [matiereId], references: [id])
  matiereId   Int

  @@unique([produitId, matiereId])
  @@map("nomenclatures")
}

model ConsommationMP {
  id          Int      @id @default(autoincrement())
  quantite    Float

  production  Production      @relation(fields: [productionId], references: [id])
  productionId Int

  matiere     MatierePremiere @relation(fields: [matiereId], references: [id])
  matiereId   Int

  @@map("consommations_mp")
}

enum StatutProduction {
  EN_ATTENTE
  EN_COURS
  TERMINEE
  ANNULEE
}
