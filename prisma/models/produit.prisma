model Produit {
  id          Int      @id @default(autoincrement())
  nom         String
  coutActuel  Float    @default(0)
  seuilBas    Float    @default(0)
  seuilHaut   Float    @default(0)
  prixVente   Float    @default(0)
  statut      StatutProduit @default(EN_ATTENTE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stock           Stock?
  lignesVente     LigneVente[]
  nomenclatures   Nomenclature[]
  historiqueCouts HistoriqueCout[]
  productions     Production[]

  @@map("produits")
}

model Stock {
  id          Int      @id @default(autoincrement())
  quantite    Float    @default(0)
  updatedAt   DateTime @updatedAt

  produit     Produit  @relation(fields: [produitId], references: [id])
  produitId   Int      @unique

  @@map("stocks")
}

model HistoriqueCout {
  id        Int      @id @default(autoincrement())
  cout      Float
  createdAt DateTime @default(now())

  produit   Produit  @relation(fields: [produitId], references: [id])
  produitId Int

  @@map("historique_couts")
}

enum StatutProduit {
  EN_ATTENTE
  ACTIF
  INACTIF
}
